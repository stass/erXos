<?xml version="1.0" encoding="UTF-8"?>
<!-- Copyright (c) 2026, Stanislav Sedov <stas@deglitch.com>
     SPDX-License-Identifier: BSD-2-Clause
     An invented peripheral holding what the PL011 does not: a register array, a device
     address, a 64-bit word, a write-only word, a read side effect beside plain fields, and
     8- and 16-bit registers side by side. -->
<device schemaVersion="1.3">
  <name>FIXTURE</name><version>1</version>
  <addressUnitBits>8</addressUnitBits><width>32</width>
  <peripherals>
    <peripheral>
      <name>FIXTURE</name><baseAddress>0</baseAddress>
      <addressBlock><offset>0</offset><size>0x1000</size><usage>registers</usage></addressBlock>
      <registers>
        <register>
          <name>SLOT[%s]</name><ownedByNif>false</ownedByNif><dim>4</dim><dimIncrement>8</dimIncrement>
          <addressOffset>0x40</addressOffset><access>read-write</access>
          <fields>
            <field><name>LOW</name><bitOffset>0</bitOffset><bitWidth>4</bitWidth></field>
            <field><name>HIGH</name><bitOffset>4</bitOffset><bitWidth>4</bitWidth></field>
            <field><name>STATE</name><bitOffset>8</bitOffset><bitWidth>2</bitWidth><access>read-only</access></field>
          </fields>
        </register>
        <register>
          <name>RING_BASE</name><ownedByNif>true</ownedByNif><size>64</size>
          <addressOffset>0x80</addressOffset><access>read-write</access>
          <fields>
            <field><name>ADDRESS</name><bitOffset>0</bitOffset><bitWidth>64</bitWidth></field>
          </fields>
        </register>
        <register>
          <name>WIDE</name><ownedByNif>false</ownedByNif><size>64</size>
          <addressOffset>0x88</addressOffset><access>read-write</access>
          <fields>
            <field><name>ALL</name><bitOffset>0</bitOffset><bitWidth>64</bitWidth></field>
          </fields>
        </register>
        <register>
          <name>DOORBELL</name><ownedByNif>false</ownedByNif>
          <addressOffset>0x90</addressOffset><access>write-only</access>
          <fields>
            <field><name>QUEUE</name><bitOffset>0</bitOffset><bitWidth>8</bitWidth></field>
          </fields>
        </register>
        <register>
          <name>POP</name><ownedByNif>false</ownedByNif>
          <addressOffset>0x94</addressOffset><access>read-write</access><readAction>clear</readAction>
          <fields>
            <field><name>VALUE</name><bitOffset>0</bitOffset><bitWidth>8</bitWidth></field>
          </fields>
        </register>
        <register>
          <name>STATUS</name><ownedByNif>false</ownedByNif>
          <addressOffset>0x98</addressOffset><access>read-write</access>
          <fields>
            <field><name>PENDING</name><bitOffset>0</bitOffset><bitWidth>4</bitWidth>
              <modifiedWriteValues>oneToClear</modifiedWriteValues>
            </field>
            <field><name>ID</name><bitOffset>4</bitOffset><bitWidth>4</bitWidth><access>read-only</access></field>
          </fields>
        </register>
        <register>
          <name>PICK</name><ownedByNif>false</ownedByNif><size>8</size>
          <addressOffset>0x9c</addressOffset><access>read-write</access>
          <fields>
            <field><name>VALUE</name><bitOffset>0</bitOffset><bitWidth>8</bitWidth></field>
          </fields>
        </register>
        <register>
          <name>COUNT</name><ownedByNif>false</ownedByNif><size>8</size>
          <addressOffset>0x9d</addressOffset><access>read-only</access>
          <fields>
            <field><name>VALUE</name><bitOffset>0</bitOffset><bitWidth>8</bitWidth></field>
          </fields>
        </register>
        <register>
          <name>HALF</name><ownedByNif>false</ownedByNif><size>16</size>
          <addressOffset>0x9e</addressOffset><access>read-write</access>
          <fields>
            <field><name>LOW</name><bitOffset>0</bitOffset><bitWidth>8</bitWidth></field>
            <field><name>TOP</name><bitOffset>8</bitOffset><bitWidth>8</bitWidth></field>
          </fields>
        </register>
      </registers>
    </peripheral>
  </peripherals>
</device>
