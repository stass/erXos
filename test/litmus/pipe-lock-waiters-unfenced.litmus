AArch64 pipe-lock-waiters-unfenced
"pipe-lock-waiters-fenced without the waiter's fence: it can miss the release while the holder misses its bit"
{
a=1;
0:X1=a; 0:X3=b;
1:X1=a; 1:X3=b;
}
 P0           | P1 ;
 MOV W0,#1    | MOV W0,#0 ;
 STR W0,[X3]  | STLR W0,[X1] ;
 LDAR W2,[X1] | DMB ISH ;
              | LDR W2,[X3] ;
exists (0:X2=1 /\ 1:X2=0)
