AArch64 pipe-lock-cur-relaxed
"pipe-lock-cur-release with a plain store releasing the lock: the next reader can take it and miss the claim"
{
a=1;
0:X1=a; 0:X3=b;
1:X1=a; 1:X3=b;
}
 P0           | P1 ;
 MOV W0,#5    | LDAR W0,[X1] ;
 STR W0,[X3]  | LDR W2,[X3] ;
 MOV W2,#0    | ;
 STR W2,[X1]  | ;
exists (1:X0=0 /\ 1:X2=0)
