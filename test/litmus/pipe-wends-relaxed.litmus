AArch64 pipe-wends-relaxed
"pipe-wends-acquire with the reader's load of wpos plain: it can see the new end's record and an old wends"
{
0:X1=a; 0:X3=b;
1:X3=b; 1:X5=c;
2:X1=a; 2:X5=c;
}
 P0           | P1           | P2 ;
 MOV W0,#2    | LDAR W0,[X3] | LDR W0,[X5] ;
 STLR W0,[X1] | MOV W2,#16   | LDR W2,[X1] ;
 MOV W2,#1    | STLR W2,[X5] | ;
 STLR W2,[X3] |              | ;
exists (1:X0=1 /\ 2:X0=16 /\ 2:X2=0)
