# Lists, counts, flattening, subscripts and positional words.
x=(a 'b c' '' d)
echo $#x
echo $"x
echo $x(2) $x(4) $x(9) $x(0)
y=(1 2 3 4 5 6)
echo $y(2-4) $y(5-) $y(3 1) $y(4-2) $y(6-9)
e=()
echo $#e $"e end
echo $#undefined
*=(p q r)
echo $1 $3 $4 $#1 $#3 $#4 $#*
name=x
echo $$name $#$name
echo 'it''s' 'a b'
z=$x
echo $#z
w=x
echo $w(1)
n=$#y
echo $n
