# if, if not, for, while, switch, ~, !, && and ||, and $status.
if(true) echo then1
if not echo else1
if(false) echo then2
if not echo else2
if(false) echo t3; if not echo e3
false
echo st $status
true
echo st2 $status
! true
echo bang $status
! false
echo bang2 $status
true && echo and1
false && echo and2
false || echo or1
true || echo or2
false && echo x || echo after
for(i in a b c) echo i $i
i=old
for(i in n m) echo $i
echo $i
*=(u v)
for(j) echo j $j
k=(1 2 3)
while(! ~ $#k 0) { echo k $k; k=$k(2-) }
echo wst $status
~ abc a*; echo m1 $status
~ abc '*'; echo m2 $status
~ b [a-c]; echo m3 $status
~ b [~a-c]; echo m4 $status
~ (x y) z y; echo m5 $status
~ 'x y' 'x y'; echo m6 $status
~ abc a?c; echo m7 $status
~ ab ?; echo m8 $status
p='*'
~ abc $p; echo m9 $status
~ '' ''; echo m10 $status
switch(foo){
case bar
	echo no
case f*
	echo yes1
case foo
	echo yes2
}
switch(zz){
case a b
	echo none
}
echo after switch
false | true
echo pipe $status
true | false
echo pipe2 $status
