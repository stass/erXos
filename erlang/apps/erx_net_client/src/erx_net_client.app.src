%% The client side of the network stack (docs/design-network-stack.md, "Modules"): the
%% socket backends every domain, and a node outside erXos beside erx_net, runs. Its one
%% call into the stack is its `grant` key's, an {M, F, A} that answers {ok, Grant}.
{application, erx_net_client,
 [{description, "erXos socket backends"},
  {vsn, "1"},
  {modules, []},
  {registered, []},
  {applications, [kernel, stdlib]},
  {env, [{grant, {erx_net, local_grant, []}}]}]}.
