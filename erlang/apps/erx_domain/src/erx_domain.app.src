%% The domain service (docs/design-system.md, "System services"): domain ids,
%% names, domain pids, the domains the system manifest configures, and
%% erx_domain, the interface other processes create and stop domains through, and
%% /dev, the device catalogue as a file tree, and erx_app_admit, the admission of
%% an app package (docs/design-packaging.md, "Admission"). It runs in the system
%% domain only, whose release alone ships it.
{application, erx_domain,
 [{description, "erXos domain service"},
  {vsn, "1"},
  {modules, [erx_app_admit,
             erx_code_objects_facet,
             erx_devfs,
             erx_devfs_core,
             erx_devices,
             erx_devices_pci,
             erx_devices_pci_core,
             erx_domain,
             erx_domain_app,
             erx_domain_core,
             erx_domain_facet,
             erx_domain_links,
             erx_domain_mints,
             erx_domain_pid,
             erx_domain_srv,
             erx_domain_sup,
             erx_firmware_worker,
             erx_ident,
             erx_login,
             erx_login_core,
             erx_login_facet,
             erx_machine,
             erx_machine_fs,
             erx_pci_bus_facet,
             erx_pci_facet,
             erx_principal]},
  {registered, [erx_domain_sup, erx_domain_srv, erx_machine]},
  {applications, [kernel, stdlib, erx, erx_files]},
  {mod, {erx_domain_app, []}}]}.
