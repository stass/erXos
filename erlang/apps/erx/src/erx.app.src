%% erXos's runtime services (docs/design-runtime.md): the console and hosted mode's
%% console driver, the kernel log, the namespace, the watchdog's petter, a driver's view
%% of its device and its device record, the inspector and its collectors, erx's shell
%% functions, and the modules tools/gen_abi.rb and tools/gen_terminal.rb generate,
%% the 9P2000.L codec erx_9p among them.
%% It starts nothing of its own: kernel's hooks start the watchdog and the namespace's
%% writer (kernel.erl) and the console (user_sup.erl), and the boot script's code path
%% finds their modules here. The console's first group runs erx_shell:console/0, so erx
%% needs erx_shell at run time; erx_shell builds on erx, so that need is a runtime
%% dependency, as kernel and stdlib name each other, not an application to start first.
{application, erx,
 [{description, "erXos runtime services"},
  {vsn, "1"},
  {modules, [erx,
             erx_9p,
             erx_abi_events,
             erx_bytes,
             erx_console,
             erx_device,
             erx_device_record,
             erx_inspector,
             erx_kernel_records,
             erx_log,
             erx_manifest,
             erx_ns,
             erx_object_info,
             erx_process_records,
             erx_schema,
             erx_source,
             erx_stdio,
             erx_text,
             erx_text_tables,
             erx_trace,
             erx_trace_ring,
             erx_tracer,
             erx_watchdog]},
  {registered, [erx_console, erx_ns, erx_watchdog]},
  {applications, [kernel, stdlib]},
  {runtime_dependencies, ["erx_shell-1"]},
  {env, []}]}.
