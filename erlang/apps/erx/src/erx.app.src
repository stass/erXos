%% erXos's runtime services (docs/design-runtime.md): the carrier between domains and
%% its connection agent, the console and hosted mode's console driver, the log sink's
%% handler, the kernel log, the namespace, the watchdog's petter, a driver's view
%% of its device and its device record, the inspector and its collectors, the tracer
%% and its ring reader, erx's shell functions, and the modules tools/gen_abi.rb and
%% tools/gen_terminal.rb generate, the 9P2000.L codec erx_9p among them.
%%
%% It starts nothing of its own; kernel starts what must run, and the boot script's
%% code path finds the modules here:
%%   kernel's hooks   the watchdog, the namespace's writer and the inspection agent
%%                    (kernel.erl) and the console (user_sup.erl)
%%   net_kernel       the carrier that -proto_dist erx names, erx_dist
%%   logger           its default handler, erx_log_h (logger.erl)
%%
%% The console's first group runs erx_shell:console/0, so erx
%% needs erx_shell at run time; erx_shell builds on erx, so that need is a runtime
%% dependency, as kernel and stdlib name each other, not an application to start first.
{application, erx,
 [{description, "erXos runtime services"},
  {vsn, "1"},
  {modules, [erx,
             erx_9p,
             erx_abi_events,
             erx_abi_signals,
             erx_build,
             erx_bytes,
             erx_connections,
             erx_console,
             erx_console_keys,
             erx_console_log,
             erx_console_menu,
             erx_device,
             erx_device_record,
             erx_dist,
             erx_domain_lib,
             erx_driver_ctl,
             erx_facet,
             erx_facets,
             erx_inspect_agent,
             erx_inspect_worker,
             erx_inspector,
             erx_kernel_records,
             erx_log,
             erx_log_facet,
             erx_log_h,
             erx_log_records,
             erx_manifest,
             erx_ns,
             erx_object_info,
             erx_present,
             erx_process_records,
             erx_runtime_records,
             erx_schema,
             erx_source,
             erx_stdio,
             erx_text,
             erx_text_tables,
             erx_trace,
             erx_trace_ring,
             erx_tracer,
             erx_tty_master,
             erx_ui_schema,
             erx_ui_wire,
             erx_watchdog,
             erx_web_proto]},
  {registered, [erx_connections, erx_console, erx_inspect_agent, erx_log_h, erx_ns, erx_watchdog]},
  {applications, [kernel, stdlib]},
  {runtime_dependencies, ["erx_shell-1"]},
  {env, []}]}.
