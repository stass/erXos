%% The network stack (docs/design-network-stack.md): the network domain's TCP/IP
%% stack, pure cores translated from FreeBSD's netinet and netinet6 under the
%% processes that own each interface, connection and socket. NOTICE-freebsd beside
%% src/ records what each module derives from.
{application, erx_net,
 [{description, "erXos TCP/IP stack"},
  {vsn, "1"},
  {modules, [erx_arp, erx_arp_wire, erx_dhcp4, erx_dhcp4_core, erx_dhcp4_wire,
               erx_icmp4, erx_icmp4_wire, erx_icmp6, erx_icmp6_wire, erx_in6_src,
               erx_ip4, erx_ip4_reass, erx_ip4_wire, erx_ip6, erx_ip6_reass,
               erx_ip6_wire, erx_ip_reass, erx_lltable, erx_nd6, erx_nd6_dad,
               erx_nd6_rtr, erx_net, erx_net_addr, erx_net_app, erx_net_bandlim,
               erx_net_bind, erx_net_clock, erx_net_credit, erx_net_driver, erx_net_eth,
               erx_net_frame, erx_net_grant, erx_net_if, erx_net_if_core, erx_net_input,
               erx_net_pipe, erx_net_rand, erx_net_route, erx_net_runtime, erx_net_sup,
               erx_net_tables, erx_net_tx, erx_tcp, erx_tcp_cc, erx_tcp_cc_cubic,
               erx_tcp_cc_newreno, erx_tcp_conn, erx_tcp_ecn, erx_tcp_icmp,
               erx_tcp_input, erx_tcp_isn, erx_tcp_loss, erx_tcp_loss_dupack,
               erx_tcp_mss, erx_tcp_output, erx_tcp_reass, erx_tcp_rtt, erx_tcp_sack,
               erx_tcp_sendlog, erx_tcp_seq, erx_tcp_sndbuf, erx_tcp_syncache,
               erx_tcp_timer, erx_tcp_timewait, erx_tcp_user, erx_tcp_wire, erx_udp,
               erx_udp_sock, erx_udp_wire]},
  {registered, []},
  {applications, [kernel, stdlib, erx]},
  {mod, {erx_net_app, []}},
  {env, []}]}.
