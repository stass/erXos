%% The host link (docs/design-live.md, "The host link"): the session between tools/erx and
%% the system domain over the second UART. erx_hostlink_frame is its wire frames,
%% erx_hostlink_stream the frames within a session (reassembly, sequence, credit) and
%% erx_hostlink_session the session protocol's pure core (hello, the call window, kept
%% replies, the facet table); erx_hostlink_payload is Phase 1's check of a payload from the
%% host. erx_hostlink is the process that performs the session's actions on the UART, under
%% erx_hostlink_sup, which erx_hostlink_app starts; erx_hostlink_install is the install
%% facet, over erx_code. erx_hostlink_files is the files stream's 9P bridge, one for each
%% session, around erx_hostlink_9p's pure core; files_trees, when set, lists the trees it
%% serves, and otherwise the system manifest's development flag decides them.
{application, erx_hostlink,
 [{description, "erXos host link"},
  {vsn, "1"},
  {modules, [erx_hostlink, erx_hostlink_9p, erx_hostlink_app, erx_hostlink_files,
             erx_hostlink_frame, erx_hostlink_install,
             erx_hostlink_payload, erx_hostlink_session, erx_hostlink_stream, erx_hostlink_sup]},
  {registered, [erx_hostlink, erx_hostlink_sup]},
  {applications, [kernel, stdlib, erx, erx_uart, erx_code]},
  {mod, {erx_hostlink_app, []}}]}.
