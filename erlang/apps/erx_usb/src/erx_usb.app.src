%% The USB stack (docs/design-usb.md), whose application module, erx_usb, starts the domain's
%% places, and then one bus group for each xHCI function record the domain holds. Its pure cores build and are tested on the host:
%% erx_hid_desc, the HID report descriptor's parser; erx_hid_core, the fold of reports into input
%% records; erx_usb_desc, the descriptor decoder; erx_usb_claim, the claim table; erx_usb_hub_core,
%% a hub function's status pipe and the hub status decoders; erx_usb_bot_core, the Bulk-Only
%% transport engine of a mass-storage function; erx_usb_bus_core, the bus process's topology of
%% hubs, ports and devices; and erx_xhci_core, the controller process's commands, pipes and
%% transfers; erx_usb_setup, a control request's setup packet. Beside them run the places,
%% erx_usb_places_sup: each input number's stream, erx_usb_input_stream, and the mint of the input tree,
%% erx_usb_input_tree, that serves them. Around the bus core run a controller's bus group,
%% erx_usb_bus_sup; the controller process, erx_xhci;
%% the bus process, erx_usb_bus,
%% which speaks to its controller through erx_usb_bus_link; and the functions, the hub function,
%% erx_usb_hub, the HID function, erx_usb_hid, and the mass-storage function, erx_usb_bot, which
%% serves a Bulk-Only interface's media through erx_blk_usb; their transfers go through erx_usb_pipe.
{application, erx_usb,
 [{description, "erXos USB stack"},
  {vsn, "1"},
  {modules, [erx_hid_core, erx_hid_desc, erx_usb, erx_usb_bot, erx_usb_bot_core, erx_usb_bus, erx_usb_bus_core, erx_usb_bus_link,
             erx_usb_bus_sup, erx_usb_claim, erx_usb_desc, erx_usb_hid, erx_usb_hub, erx_usb_hub_core,
             erx_usb_input_stream, erx_usb_input_tree, erx_usb_pipe, erx_usb_places_sup, erx_usb_quirks, erx_usb_setup,
             erx_xhci, erx_xhci_core]},
  {registered, [erx_usb]},
  {applications, [kernel, stdlib, erx, erx_files, erx_blk]},
  {mod, {erx_usb, []}},
  {env, []}]}.
