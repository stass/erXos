%% The command shell with rc's language (docs/design-shell.md): its tokenizer
%% and its parser, pure functions from a line or script to a syntax tree,
%% and its evaluator, which runs a tree through a runner it is handed.
%% Its interactive layer runs the shell on the console, with a stand-in
%% runner until the command namespace exists.
{application, erx_shell,
 [{description, "erXos command shell"},
  {vsn, "1"},
  {modules, [erx_shell,
             erx_shell_basic_runner,
             erx_shell_eval,
             erx_shell_lex,
             erx_shell_parse]},
  {registered, []},
  {applications, [kernel, stdlib, erx]},
  {env, []}]}.
