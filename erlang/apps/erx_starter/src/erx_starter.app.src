%% The start service (docs/design-apps.md, "The start table"): the start
%% table, the manifest's start rows with rc.conf over them, and what keeps
%% each enabled row's session. It runs in the system domain only, whose
%% release alone ships it.
{application, erx_starter,
 [{description, "erXos start service"},
  {vsn, "1"},
  {modules, [erx_start_table, erx_starter, erx_starter_app, erx_starter_keeper, erx_starter_rc,
             erx_starter_row, erx_starter_sup]},
  {registered, [erx_starter, erx_starter_sup, erx_starter_keepers]},
  {mod, {erx_starter_app, []}},
  {applications, [kernel, stdlib, erx, erx_domain]}]}.
