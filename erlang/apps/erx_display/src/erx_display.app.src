%% The display domain's services (docs/design-display.md): the screen's pure
%% core, erx_screen_core, which decides what erx_screen composes, fills,
%% exposes and pushes; the window policy behaviour erx_wm with
%% erx_wm_single; erx_wctl, the text of a window's wctl file; and erx_ui_model,
%% the realised widget tree and its one difference; and erx_vt, the terminal
%% emulator's core, with its generated width table erx_vt_width; the draw
%% protocol's codec erx_draw_codec, generated from abi/formats/draw.txt, and
%% erx_draw_image, the decoder of a Y message's compressed pixels; erx_vt reads
%% erx: links through erx's erx_present.
{application, erx_display,
 [{description, "erXos display services"},
  {vsn, "1"},
  {modules, [erx_draw_codec, erx_draw_image, erx_screen_core, erx_ui_model, erx_vt, erx_vt_width, erx_wctl, erx_wm,
              erx_wm_single]},
  {registered, []},
  {applications, [kernel, stdlib, erx]},
  {env, []}]}.
