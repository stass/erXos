%% The display domain's side of the window system (docs/design-display.md,
%% "What runs where"): the display driver behaviour erx_display, which the
%% display drivers of erx_fb implement; the screen, erx_screen over its pure
%% core erx_screen_core, which decides what it composes, fills, exposes and
%% pushes, and which erx_fb_sup starts behind the driver; the window policy
%% behaviour erx_wm with erx_wm_single; and erx_wctl, the text of a window's
%% wctl file. A library application: it starts no process of its own, and
%% none of its modules decodes a client's draw, picture, font or widget bytes
%% (G9).
{application, erx_display,
 [{description, "erXos display services"},
  {vsn, "1"},
  {modules, [erx_display, erx_screen, erx_screen_core, erx_wctl, erx_wm, erx_wm_single]},
  {registered, []},
  {applications, [kernel, stdlib, erx, erx_memdraw]},
  {env, []}]}.
