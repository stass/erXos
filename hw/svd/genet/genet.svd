          <addressOffset>0x4</addressOffset><access>read-write</access>
          <fields>
            <field><name>MODE</name><description>Written whole: 3 for an external gigabit PHY over RGMII, 0 otherwise (if_genetreg.h:48; if_genet.c:915-925)</description><bitOffset>0</bitOffset><bitWidth>32</bitWidth></field>
          </fields>
