<?xml version="1.0" encoding="UTF-8"?>
<!-- Copyright (c) 2026, Stanislav Sedov <stas@deglitch.com>
     SPDX-License-Identifier: BSD-2-Clause

     The BCM2711's Ethernet controller, GENET v5, written by erXos from FreeBSD's
     driver at commit 975e3605ebb1: sys/arm64/broadcom/genet/if_genetreg.h (SHA-256
     5af53d306f839dc4742a52201059bdeadc7a305bee77cf686b45e8df69035b6e) for each
     register and field, cited by line, and sys/arm64/broadcom/genet/if_genet.c
     (SHA-256 fbf5c90dd089fa759e04dd0c72f97e688bfc97e2855d65011cf42d4511cfd459) for
     what its driver writes. No public datasheet describes the controller, so this
     file holds only the registers and bits FreeBSD names, as FreeBSD uses them. A
     bit FreeBSD leaves unnamed is in no field, so write/3 refuses a word that sets
     it; where FreeBSD writes a value it does not split into bits, the field is the
     whole word. The window is the device tree's `brcm,bcm2711-genet-v5` node,
     0x10000 bytes (docs/design-platforms.md, "Raspberry Pi 4 Model B").

     The descriptors are registers, not memory: 256 per direction, each three words
     12 bytes apart, receive at 0x2000 and transmit at 0x4000 (if_genetreg.h:116-124,
     168-192). Past each direction's descriptors, at 0xc00, lie the registers of its
     17 rings, 0x40 apart (if_genetreg.h:120-121, 126, 148), and then the direction's
     ring configuration and DMA control at 0x1040 (if_genetreg.h:209-219). FreeBSD
     drives ring 16, the default queue (if_genetreg.h:118). The device NIF owns each
     descriptor's three registers, every ring's indexes, buffer size and pointers,
     and each direction's ring configuration and DMA control, which aim the
     controller at memory and say which descriptors it takes. The thresholds, burst
     sizes, interrupt, buffer, MAC and MDIO registers are the driver's. That leaves
     no write of the driver's able to move DMA outside a buffer only if a ring's
     buffer size bounds every byte the controller writes per descriptor, whatever
     the frame length limit, the status block, the alignment padding and the burst
     size say: unverified, and settled on the board. -->
<device schemaVersion="1.3">
  <name>GENET</name><version>5</version>
  <description>BCM2711 GENET v5 Ethernet controller</description>
  <addressUnitBits>8</addressUnitBits><width>32</width>
  <peripherals>
    <peripheral>
      <name>GENET</name><baseAddress>0</baseAddress>
      <addressBlock><offset>0</offset><size>0x10000</size><usage>registers</usage></addressBlock>
      <registers>
        <register>
          <name>SYS_REV_CTRL</name><ownedByNif>false</ownedByNif>
          <description>GENET_SYS_REV_CTRL (if_genetreg.h:38): the controller's revision; FreeBSD attaches major 6 only (if_genet.c:264-272)</description>
          <addressOffset>0x0</addressOffset><access>read-only</access>
          <fields>
            <field><name>PHY</name><description>Internal PHY revision (if_genetreg.h:46)</description><bitOffset>0</bitOffset><bitWidth>16</bitWidth></field>
            <field><name>MINOR</name><description>Minor revision (if_genetreg.h:40, 44)</description><bitOffset>16</bitOffset><bitWidth>4</bitWidth></field>
            <field><name>MAJOR</name><description>Major revision, 6 for GENET v5 (if_genetreg.h:39, 41-43)</description><bitOffset>24</bitOffset><bitWidth>4</bitWidth></field>
          </fields>
        </register>
        <register>
