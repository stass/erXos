            <field><name>RGMII_MODE_EN</name><description>Enable RGMII (if_genetreg.h:54)</description><bitOffset>6</bitOffset><bitWidth>1</bitWidth></field>
            <field><name>ID_MODE_DISABLE</name><description>Disable the MAC's internal delay (if_genetreg.h:53)</description><bitOffset>16</bitOffset><bitWidth>1</bitWidth></field>
          </fields>
        </register>
        <register>
          <name>INTRL2_CPU_STAT</name><ownedByNif>false</ownedByNif>
          <description>GENET_INTRL2_CPU_STAT (if_genetreg.h:57): pending interrupts, masked or not (if_genet.c:1354-1355)</description>
          <addressOffset>0x200</addressOffset><access>read-only</access>
