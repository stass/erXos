            <field><name>RXDMA_DONE</name><description>A receive descriptor was filled (if_genetreg.h:65)</description><bitOffset>13</bitOffset><bitWidth>1</bitWidth></field>
            <field><name>TXDMA_DONE</name><description>A transmit descriptor was sent (if_genetreg.h:64)</description><bitOffset>16</bitOffset><bitWidth>1</bitWidth></field>
            <field><name>MDIO_DONE</name><description>An MDIO command finished (if_genetreg.h:63)</description><bitOffset>23</bitOffset><bitWidth>1</bitWidth></field>
            <field><name>MDIO_ERROR</name><description>An MDIO command failed (if_genetreg.h:62)</description><bitOffset>24</bitOffset><bitWidth>1</bitWidth></field>
