CONFIG_ARM=y
CONFIG_PF_ARM_GEN=y
CONFIG_ARM_V8A_GENERIC=y
CONFIG_MP=y
CONFIG_MP_MAX_CPUS=8
CONFIG_DT=y
CONFIG_ARM_PSCI=y
CONFIG_ARM_SMC_USER=y
CONFIG_FPU=y
# CONFIG_ARM_SVE is not set
CONFIG_SYNC_CLOCK=y
# One-shot timer: each timeout and slice end programs the timer, and an idle CPU
# with no RCU work pending takes no tick. Kconfig selects fine-grained CPU time and
# implies tickless idle.
CONFIG_ONE_SHOT=y
CONFIG_BENCHMARKING=y
CONFIG_PERF_CNT=y
CONFIG_PERF_CNT_USER=y
# Every kernel object keeps its id, which names threads and spaces in the
# kernel's trace rings (docs/design-fiasco.md, "The kernel's trace rings").
CONFIG_RT_DBG=y
CONFIG_EXPERT=y
CONFIG_NO_VERSION=y
# CONFIG_CPU_VIRT is not set
# No build has the kernel debugger or the kernel's own console input, so a fatal
# kernel error resets (docs/design-debugger.md, "On Fiasco"). L4Re's comparison
# kernel turns the debugger on (tools/lib/erx/l4re_build.rb) without its logging,
# which slows measured paths, or its compression.
# CONFIG_JDB is not set
# CONFIG_INPUT is not set
# CONFIG_JDB_LOGGING is not set
# CONFIG_JDB_GZIP is not set
# CONFIG_JDB_DISASM is not set
# CONFIG_COV is not set
# The build names its LLVM programs in Makeconf.local; these keep the record truthful.
CONFIG_CC="clang"
CONFIG_CXX="clang++"
CONFIG_LD="ld.lld"
