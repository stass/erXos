#
# The EROFS oracle's Linux guest (tools/lib/erx/linux_guest.rb), run as the
# initramfs's /init: loads Linux's EROFS driver, mounts each EROFS image the host
# attached, read-only, prints what Linux sees in it as the manifest of
# tools/lib/erx/erofs_manifest.rb on the serial console, and powers off. The host
# attaches image I as the virtio disk whose serial is erx-image-I and passes the
# count as erx.images=N on the kernel command line. Diagnostics start with
# "erx-guest: ", which the manifest's parser skips. Errors of the tools that touch
# the images go to /dev/null, so no file name reaches the console raw.
/bin/busybox --install -s /bin
export PATH=/bin
mkdir -p /proc /sys /dev /mnt
mount -t proc proc /proc
mount -t sysfs sysfs /sys
mount -t devtmpfs devtmpfs /dev

for module in libcrc32c virtio_blk erofs; do
	insmod "/lib/modules/$module.ko.xz" || echo "erx-guest: module $module did not load"
done

count=0
for word in $(cat /proc/cmdline); do
	case $word in
	erx.images=*) count=${word#erx.images=} ;;
	esac
done

# The device node of the disk whose serial is erx-image-$1, or nothing.
device_of() {
	for block in /sys/block/vd*; do
		if [ "$(cat "$block/serial" 2>/dev/null)" = "erx-image-$1" ]; then
			echo "/dev/${block##*/}"
		fi
	done
}

index=0
while [ "$index" -lt "$count" ]; do
	device=$(device_of "$index")
	if [ -z "$device" ]; then
		echo "erx-erofs: refused $index nodevice"
	elif mount -t erofs -o ro "$device" /mnt 2> /dev/null; then
		find /mnt -exec /describe {} + > /entries 2> /dev/null
		lines=$(wc -l < /entries)
		echo "erx-erofs: image $index"
		cat /entries
		echo "erx-erofs: end $index $((lines))"
		umount /mnt || echo "erx-guest: image $index did not unmount"
	else
		echo "erx-erofs: refused $index mount"
	fi
	index=$((index + 1))
done
echo "erx-erofs: done $count"
# The kernel's own messages, EROFS's errors among them, for the log; each starts
# with "[", so the manifest's parser skips them.
dmesg
poweroff -f
