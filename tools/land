require 'optparse'
require_relative 'lib/erx/land'

# usage: tools/land COMMIT      cherry-pick one commit onto HEAD
#        tools/land --continue  finish the pick after a stop
#
# Regenerates and continues when only the ABI generator's outputs conflict.
# Anything else stops the pick, in progress, with the files listed: exit 1.
# One commit at a time, since nothing would remember the rest across a stop.
ROOT = File.expand_path('..', __dir__)
COMMIT = %r{\A[0-9A-Za-z][0-9A-Za-z._/~^-]*\z}

def report(label, outcome)
  case outcome.state
  when :picked then Erx::Terminal.puts("#{label}: picked")
  when :refreshed then Erx::Terminal.puts("#{label}: picked, stale ABI outputs regenerated into it")
  when :regenerated then Erx::Terminal.puts("#{label}: picked, #{outcome.paths.size} conflicted ABI outputs regenerated")
  when :stopped
    Erx::Terminal.puts("#{label}: stopped; resolve and add these, then run tools/land --continue:")
    outcome.paths.each { |path| Erx::Terminal.puts("  #{path}") }
  end
  outcome.state == :stopped ? 1 : 0
end

begin
  resume = false
  parser = OptionParser.new do |flags|
    flags.banner = 'Usage: tools/land COMMIT | tools/land --continue'
    flags.on('--continue', 'Finish a pick after resolving what it listed') { resume = true }
  end
  commits = parser.parse(ARGV)
  named_one = commits.size == 1 && COMMIT.match?(commits.first) && !commits.first.include?('..')
  unless resume ? commits.empty? : named_one
    raise OptionParser::InvalidArgument, 'give one commit, not a range, or --continue alone'
  end

  land = Erx::Land.new(root: ROOT, runner: Erx::Runner.new(owner_root: ROOT, log_dir: File.join(ROOT, 'build/logs')))
  exit(resume ? report('continue', land.resume) : report(commits.first, land.pick(commits.first)))
rescue OptionParser::ParseError => error
  Erx::Terminal.puts(error.message)
  exit 2
rescue Erx::Error, SystemCallError => error
  Erx::Terminal.puts(error.message)
  exit 1
end
