    def self.build(input_arguments)
      arguments = input_arguments.dup
      component = arguments.shift
      unless %w[fiasco runtime jit-runtime rc-oracle fsimg herd7].include?(component)
        raise OptionParser::InvalidArgument, 'build accepts fiasco, runtime, jit-runtime, rc-oracle, fsimg or herd7'
      end
      jobs = 4
      parser = OptionParser.new do |options|
        options.on('--jobs N', Integer, 'Parallel inherited build jobs') { |value| jobs = value }
      end
      parser.parse!(arguments)
      raise OptionParser::InvalidArgument, 'unexpected arguments' unless arguments.empty?
      path = case component
             when 'runtime' then build_runtime(jobs)
             when 'jit-runtime' then build_jit_runtime(jobs)
             when 'rc-oracle' then build_rc_oracle
             when 'fsimg' then build_fsimg(jobs)
             when 'herd7' then build_herd7(jobs)
             else Fiasco.new(root: ROOT).build(jobs: jobs)
             end
      Terminal.puts("built #{path}")
      0
    end

    # The development boot image in QEMU with its serial line on this terminal,
    # for a person to type at (InteractiveBoot). The arguments are read whole
    # before anything is built or run.
