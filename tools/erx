module Erx
  ROOT = File.expand_path('..', __dir__)

  module CLI
    def self.run(arguments, **collaborators)
      command, *command_arguments = arguments
      case command
      when 'check'
        check(command_arguments, **collaborators)
      when 'generate'
        generate(command_arguments, **collaborators)
      when 'check-reproducible'
        check_reproducible(command_arguments, **collaborators)
      when 'check-fuzz'
        check_fuzz(command_arguments, **collaborators)
      when 'check-sanitizers'
        check_sanitizers(command_arguments, **collaborators)
      when 'check-ubsan'
        check_sanitizers(command_arguments, **collaborators)
        Terminal.puts('unsupported: kernel UBSan boot requires erXos kernel implementation; host UBSan checks passed')
        1
      when 'gates'
        gates(command_arguments, **collaborators)
      when 'pack'
        pack(command_arguments, **collaborators)
      when 'status'
        status(command_arguments, **collaborators)
      when 'setup'
        setup(command_arguments, **collaborators)
      when 'fetch'
        fetch(command_arguments, **collaborators)
      when 'check-tla'
        check_tla(command_arguments, **collaborators)
      when 'check-cbmc'
        check_cbmc(command_arguments, **collaborators)
      when 'check-litmus'
        no_arguments(command_arguments)
        check_litmus
      when 'check-sources'
        check_sources(command_arguments, **collaborators)
      when 'check-stack-proof'
        check_stack_proof(command_arguments, **collaborators)
      when 'sysreg'
        sysreg(command_arguments)
      when 'check-arch-terms'
        check_arch_terms(command_arguments, **collaborators)
      when 'build'
        build(command_arguments, **collaborators)
      when 'check-runtime-seam'
        check_runtime_seam(command_arguments, **collaborators)
      when 'boot'
        boot(command_arguments, **collaborators)
      when 'qemu'
        qemu(command_arguments, **collaborators)
      when 'conformance'
        conformance(command_arguments, **collaborators)
      when 'check-qemu'
        check_qemu(command_arguments, **collaborators)
      when 'check-boot-image'
        check_boot_image(command_arguments, **collaborators)
      when 'check-debug-log'
        check_debug_log(command_arguments, **collaborators)
      when 'oracle'
        oracle(command_arguments, **collaborators)
      when 'bench'
        bench(command_arguments, **collaborators)
      when 'check-libc-test'
        check_libc_test(command_arguments)
      when 'check-oracle'
        check_oracle(command_arguments, **collaborators)
      when 'load', 'watch'
        code_command(command, command_arguments)
      when 'files'
        files_command(command_arguments)
      when '--help', '-h', nil
        help(command_arguments, **collaborators)
      else
        raise OptionParser::InvalidArgument, "unknown command: #{command}"
      end
    rescue OptionParser::ParseError => error
      Terminal.puts(error.message)
      2
    rescue Error, SystemCallError => error
      Terminal.puts(error.message)
      1
    end

    def self.check(input_arguments, runner_class: Runner, checks_class: Checks, arch_terms: ArchTerms,
                   runtime: method(:with_test_runtime), rc_oracle: method(:ensure_rc_oracle))
      arguments = input_arguments.dup
      OptionParser.new.parse!(arguments)
      raise OptionParser::InvalidArgument, 'unexpected arguments' unless arguments.empty?

      runner = runner_class.new(owner_root: ROOT, log_dir: File.join(ROOT, 'build/logs'))
      checks_class.new(root: ROOT, runner: runner).run
      arch_terms.check(root: ROOT)
      rc_oracle.call(runner: runner)
      runtime.call(runner: runner) do |environment|
        stack_proof(runner: runner, environment: environment)
        tests = Dir.glob(File.join(ROOT, 'test/host/*_test.rb')).sort
        raise Error, 'no host tests found' if tests.empty?
        run_tests(tests, runner: runner, name: 'host-tests', environment: environment)
        run_tests(integration_tests(ROOT), runner: runner, name: 'native-integration', environment: environment)
      end
      Terminal.puts('offline source, generation, host and native integration checks passed')
      0
    end

    # The command shell's integration tests (erx_shell_corpus, erx_shell_commands) run
    # against plan9port's rc, built on the host. `make setup` builds it, but a change to
    # its recipe or pin leaves that build stale, so check builds it again, from the
    # fetched pin and offline, whenever RcOracle.locate refuses what is there.
    def self.ensure_rc_oracle(runner:, root: ROOT, build_class: RcOracle::Build)
      RcOracle.locate(root: root)
    rescue RcOracle::MissingBuild, RcOracle::StaleBuild
      build_class.new(root: root, runner: runner).call
      RcOracle.locate(root: root)
    end

    # An integration test runs in `make check` unless it is excused here: these
    # rebuild the stopgap kernel, boot it under QEMU, need the stock OTP
    # suites' runtime, need the hosted runtime built, or need Arm's register
    # archive fetched. check ensures the rc oracle first (ensure_rc_oracle),
    # so the tests that read plan9port's rc run in it.
    STANDALONE_INTEGRATION_TESTS = %w[domain_image fiasco_reproducible native_seeds oracle_ct_oracle oracle_reporter qemu_gate_mutant runtime_console runtime_device runtime_hosted_smoke runtime_literal_token runtime_prim_file runtime_release sysreg_refresh oracle_log_tree].freeze

    def self.integration_tests(root)
      excused = STANDALONE_INTEGRATION_TESTS.map { |name| "#{name}_test.rb" }
      tests = Dir.glob('*_test.rb', base: File.join(root, 'test/integration')).sort - excused
      raise Error, 'no integration tests found' if tests.empty?

      tests.map { |test| File.join(root, 'test/integration', test) }
    end

    # Reports what bringing build/gen up to date did, which tools/erx does
    # before any command: regenerated, or found it current.
    def self.generate(arguments, tree: ENTRY_TREE)
      no_arguments(arguments)
      Terminal.puts("generated files in #{tree.output}: #{tree.status == :fresh ? 'up to date' : 'regenerated'}")
      0
    end

    # The clang and lld every build and test gate uses: ERX_CLANG and ERX_LLD,
    # an LLVM installation whose resource headers the reviewed LLVM profile
    # admits. An arbitrary compiler selected by PATH cannot stand in for it.
    def self.host_environment(runner:)
      compiler = ENV['ERX_CLANG']
      raise Error, 'set ERX_CLANG to an installed LLVM clang; see README.md' if !compiler || compiler.empty?
      compiler = File.realpath(compiler)
      raise Error, 'ERX_CLANG is not an executable compiler' unless File.file?(compiler) && File.executable?(compiler)
      path = [File.dirname(compiler), ENV.fetch('PATH', '')].join(File::PATH_SEPARATOR)
      linker = executable_on(ENV.fetch('ERX_LLD', 'ld.lld'), path: path)
      resource = runner.run([compiler, '-print-resource-dir'], name: 'check-clang-resource', deadline: 30)
      ToolchainProvenance.llvm(root: ROOT, resource_dir: BoundedFile.read(resource.fetch('log'), maximum: 4096).strip)
      { 'ERX_CLANG' => compiler, 'CC' => compiler, 'ERX_LLD' => linker, 'PATH' => path }
        .merge(SanitizerEnvironment.call(compiler: compiler)).freeze
    end

    # program as an absolute path: itself when it names a directory, else the
    # first executable of that name on path, so every later step runs the
    # same lld whatever directory it starts in.
    def self.executable_on(program, path:)
      found = if program.include?('/')
                File.expand_path(program)
              else
                path.split(File::PATH_SEPARATOR).map { |directory| File.join(directory, program) }
                    .find { |candidate| File.file?(candidate) && File.executable?(candidate) }
              end
      raise Error, "ERX_LLD names no executable linker" unless found && File.file?(found) && File.executable?(found)

      found
    end

    def self.with_test_runtime(runner:, oracle_class: Oracle, host_environment: method(:host_environment))
      environment = host_environment.call(runner: runner)
      oracle_class.new(root: ROOT, runner: runner).with_runtime('jit') do |runtime|
        yield Oracle::CLEAN_ERLANG_ENV.merge(environment)
                  .merge('ERX_ERL' => runtime.fetch('erl'), 'ERX_ERLC' => runtime.fetch('erlc')).freeze
      end
    end

    # Seconds one test file may run before it is killed. The slowest file takes
    # about 230 s under sanitizers on a loaded 16-CPU host, so this is about four
    # times that, and a hang costs one file's deadline, not the step's.
    TEST_FILE_DEADLINE = 900

    # Each file is its own process, under its own deadline (see TestPool).
    def self.run_tests(paths, runner:, name:, environment:, deadline: TEST_FILE_DEADLINE)
      TestPool.run(paths, runner: runner, name: name, environment: environment, deadline: deadline, root: ROOT)
    end

    def self.check_reproducible(arguments)
      no_arguments(arguments)
      require_relative 'lib/erx/production_image'
      runner = Runner.new(owner_root: ROOT, log_dir: File.join(ROOT, 'build/logs'))
      environment = host_environment(runner: runner)
      compiler = environment.fetch('ERX_CLANG')
      fiasco = Fiasco.new(root: ROOT, runner: runner, compiler: compiler)
      fiasco.build(jobs: 4)
      parent = File.join(ROOT, 'build/reproducible')
      OutputDirectory.prepare(root: ROOT, path: parent)
      report = ProductionImage.new(root: ROOT, runner: runner, compiler: compiler, linker: environment.fetch('ERX_LLD'), fiasco: fiasco)
                              .check_reproducible(directory: Dir.mktmpdir('production-', parent))
      Terminal.puts("production image: byte-identical; #{report.fetch('report')}")
      claims = report.fetch('manifest')
      Terminal.puts("root_startup: #{claims.fetch('root_startup')}; policy_admission: #{claims.fetch('policy_admission')}; " \
                    "child_plan_instances: #{claims.fetch('child_plan_instances')}")
      0
    end

    def self.check_sanitizers(arguments, runner_class: Runner, runtime: method(:with_test_runtime))
      no_arguments(arguments)
      runner = runner_class.new(owner_root: ROOT, log_dir: File.join(ROOT, 'build/logs'))
      tests = SanitizerTests.discover(root: ROOT)
      runtime.call(runner: runner) do |environment|
        run_tests(tests.map { |test| File.join(ROOT, test) }, runner: runner, name: 'sanitizer-tests',
                  environment: environment.merge('ERX_SANITIZERS' => 'address,undefined'))
      end
      Terminal.puts('these tests passed with ERX_SANITIZERS=address,undefined: ' \
                    "#{tests.map { |test| File.basename(test, '_test.rb') }.join(' ')}")
      if RbConfig::CONFIG.fetch('host_os').include?('darwin')
        Terminal.puts('LeakSanitizer and ASan initialization-order checks: unsupported on macOS; Linux run required')
      end
      0
    end

    # What the discovered gates run, one line each, for a reader or a diff.
    def self.gates(arguments)
      no_arguments(arguments)
      require_relative 'fuzz/run_pack'
      SanitizerTests.discover(root: ROOT).each { |test| Terminal.puts("sanitizer test: #{test}") }
      serial = Dir.glob('test/{host,integration}/*_test.rb', base: ROOT).sort
                  .select { |test| TestPool.serial?(File.join(ROOT, test)) }
      Terminal.puts("test pool: #{TestPool.jobs} parallel processes (#{TestPool::JOBS_VARIABLE} overrides); " \
                    "each file under its own #{TEST_FILE_DEADLINE}s deadline; " \
                    "serial files: #{serial.empty? ? 'none' : serial.join(' ')}")
      QemuGate.suites.each { |suite| Terminal.puts("QEMU suite: #{suite.name}") }
      PackFuzz.targets.each do |target|
        Terminal.puts("native fuzz target: #{target.kind}: #{target.seeds.size} seeds; " \
                      "sources #{target.sources.join(' ')}; includes #{target.includes.join(' ')}")
      end
      ChokepointRules::ALL.sort_by(&:name).each do |rule|
        seeds = rule.respond_to?(:seed) ? rule.seed.size : 0
        Terminal.puts("chokepoint rule: #{rule.name}: #{rule.class.name.split('::').last}, #{seeds} seeds")
      end
      0
    end

    def self.check_fuzz(input_arguments, runner_class: Runner, runtime: method(:with_test_runtime),
                        c_fuzzer: method(:fuzz_c), ruby_fuzzer: method(:fuzz_ruby))
      arguments = input_arguments.dup
      options = { seconds: 3, runs: 20_000, seed: 1 }
      OptionParser.new do |flags|
        flags.on('--seconds N', Integer, 'Budget per timed Ruby target, 1..60') { |value| options[:seconds] = value }
        flags.on('--runs N', Integer, 'C libFuzzer executions per target, 1..10000000') { |value| options[:runs] = value }
        flags.on('--seed N', Integer, 'Seed for C ABI and timed Ruby targets') { |value| options[:seed] = value }
      end.parse!(arguments)
      unless arguments.empty? && options.fetch(:seconds).between?(1, 60) &&
             options.fetch(:runs).between?(1, 10_000_000) && options.fetch(:seed).between?(0, (1 << 31) - 1)
        raise OptionParser::InvalidArgument, 'fuzz budget, seed or trailing arguments outside bounds'
      end
      runner = runner_class.new(owner_root: ROOT, log_dir: File.join(ROOT, 'build/logs'))
      runtime.call(runner: runner) do |environment|
        c_fuzzer.call(runner: runner, environment: environment, runs: options.fetch(:runs), seed: options.fetch(:seed))
        ruby_fuzzer.call(runner: runner, environment: environment, seconds: options.fetch(:seconds), seed: options.fetch(:seed))
        runner.run([RbConfig.ruby, File.join(ROOT, 'test/host/abi_erlang_test.rb'),
                    '--name', 'test_production_fuzz_entry_refuses_mutations_without_vm_exception'],
                   name: 'fuzz-erlang-manifest', deadline: 180, chdir: ROOT, env: environment)
        runner.run([RbConfig.ruby, File.join(ROOT, 'tools/fuzz/erx_manifest.rb'), '--seed', options.fetch(:seed).to_s],
                   name: 'fuzz-erx-manifest', deadline: 660, chdir: ROOT, env: environment)
        runner.run([RbConfig.ruby, File.join(ROOT, 'tools/fuzz/erx_console_input.rb'), '--seed', options.fetch(:seed).to_s],
                   name: 'fuzz-erx-console-input', deadline: 300, chdir: ROOT, env: environment)
        runner.run([RbConfig.ruby, File.join(ROOT, 'tools/fuzz/erx_pl011_console_uart.rb'), '--seed',
                    options.fetch(:seed).to_s],
                   name: 'fuzz-erx-pl011-console-uart', deadline: 300, chdir: ROOT, env: environment)
        runner.run([RbConfig.ruby, File.join(ROOT, 'tools/fuzz/erx_device_record.rb'), '--seed', options.fetch(:seed).to_s],
                   name: 'fuzz-erx-device-record', deadline: 300, chdir: ROOT, env: environment)
        runner.run([RbConfig.ruby, File.join(ROOT, 'tools/fuzz/erx_schema.rb'), '--seed', options.fetch(:seed).to_s],
                   name: 'fuzz-erx-schema', deadline: 300, chdir: ROOT, env: environment)
        runner.run([RbConfig.ruby, File.join(ROOT, 'tools/fuzz/erx_procfs.rb'), '--seed', options.fetch(:seed).to_s],
                   name: 'fuzz-erx-procfs', deadline: 300, chdir: ROOT, env: environment)
        runner.run([RbConfig.ruby, File.join(ROOT, 'tools/fuzz/erx_blk_request.rb'), '--seed', options.fetch(:seed).to_s],
                   name: 'fuzz-erx-blk-request', deadline: 300, chdir: ROOT, env: environment)
        runner.run([RbConfig.ruby, File.join(ROOT, 'tools/fuzz/erx_blk_table.rb'), '--seed', options.fetch(:seed).to_s],
                   name: 'fuzz-erx-blk-table', deadline: 300, chdir: ROOT, env: environment)
        runner.run([RbConfig.ruby, File.join(ROOT, 'tools/fuzz/erx_code_request.rb'), '--seed', options.fetch(:seed).to_s],
