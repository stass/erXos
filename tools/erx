    def self.oracle(input_arguments, native_class: Oracle, container_class: OracleContainer,
                    hosted_class: OracleHosted, qemu_class: OracleQemu)
      arguments = input_arguments.dup
      action = arguments.shift
      return oracle_hosted(arguments, hosted_class: hosted_class) if action == 'hosted'
      return oracle_qemu(arguments, qemu_class: qemu_class) if action == 'qemu'
      unless %w[build run probe].include?(action)
        raise OptionParser::InvalidArgument, 'usage: oracle build|run SUITE|probe [--docker-context NAME] [--flavour emu|jit] | ' \
                                           'oracle hosted [--out DIR] [--deadline SECONDS] [--suites LIST] | ' \
                                           'oracle qemu [--out DIR] [--deadline SECONDS] [--accel tcg|hvf] [--cpus N] [--suites LIST]'
      end
      suite = arguments.shift if action == 'run'
      options = { backend: 'linux', flavour: 'emu', jobs: 4, deadline: 14_400, clean: false }
      OptionParser.new do |flags|
        flags.on('--backend NAME', %w[linux native], 'Linux suites or native bootstrap build') { |value| options[:backend] = value }
        flags.on('--docker-context NAME', 'Explicit local Docker context; cached pinned image only') { |value| options[:context] = value }
        flags.on('--flavour NAME', %w[emu jit]) { |value| options[:flavour] = value }
        flags.on('--jobs N', Integer) { |value| options[:jobs] = value } unless action == 'probe'
        if action == 'run'
          flags.on('--deadline SECONDS', Integer, 'Suite hard deadline') { |value| options[:deadline] = value }
          flags.on('--suite NAME', 'Select one stock Common Test suite') { |value| options[:test_suite] = value }
          flags.on('--case NAME', 'Select a case within --suite') { |value| options[:testcase] = value }
        end
        if action == 'build'
          flags.on('--clean', 'Replace an existing native bootstrap build') { options[:clean] = true }
        end
      end.parse!(arguments)
      raise OptionParser::InvalidArgument, 'unexpected arguments' unless arguments.empty?
      unless options.fetch(:jobs).between?(1, 64)
        raise OptionParser::InvalidArgument, 'jobs must be between 1 and 64'
      end
      if options.fetch(:backend) == 'native'
        unless action == 'build' && !options[:context]
          raise OptionParser::InvalidArgument, 'native backend supports bootstrap build only, without Docker context'
        end
        native_class.new(root: ROOT).build(flavours: [options.fetch(:flavour)], jobs: options.fetch(:jobs), clean: options.fetch(:clean))
        Terminal.puts("native stock OTP bootstrap #{options.fetch(:flavour)} ready")
        return 0
      end
      raise OptionParser::InvalidArgument, '--clean applies to native bootstrap builds' if options.fetch(:clean)
      backend = container_class.new(root: ROOT, context: options[:context])
      result = case action
               when 'build'
                 backend.build(flavours: [options.fetch(:flavour)], jobs: options.fetch(:jobs)).first
               when 'probe'
                 backend.probe(flavour: options.fetch(:flavour))
               when 'run'
                 backend.run(suite, flavour: options.fetch(:flavour), jobs: options.fetch(:jobs),
                             deadline: options.fetch(:deadline), test_suite: options[:test_suite], testcase: options[:testcase])
               end
      Terminal.puts("Linux host oracle: #{result.fetch('state')}; #{result.fetch('report')}")
      result.fetch('state') == 'completed' || result.fetch('state') == 'ready' ? 0 : 1
    end

    # OTP's suite groups under Common Test on the hosted runtime and on stock
    # OTP, compared case by case against each group's table of known
    # differences. `--suites` names groups, `group/SUITE`s or `fast`, and
    # defaults to `fast`; the exit is 0 only when every group's comparison
    # passes.
    def self.oracle_hosted(arguments, hosted_class:)
      options = { out: File.join(ROOT, 'build/oracle-hosted'), deadline: 1800, suites: ['fast'] }
      OptionParser.new do |flags|
        flags.on('--out DIR', 'Directory for the trees, event streams, logs and reports') { |value| options[:out] = value }
        flags.on('--deadline SECONDS', Integer, 'Hard deadline of each run') { |value| options[:deadline] = value }
        suites_option(flags, options)
      end.parse!(arguments)
      selection = oracle_selection(arguments, options)
      oracle_groups(selection, out: options[:out]) do |group, suites, out|
        hosted_class.new(root: ROOT, out: out, deadline: options[:deadline], group: group).run(suites).result
      end
    end

    # The same suites in the system domain under QEMU, compared with stock OTP
    # against the same tables. The exit is 0 only when every group's
    # comparison passes.
    def self.oracle_qemu(arguments, qemu_class:)
      options = { out: File.join(ROOT, 'build/oracle-qemu'), deadline: 1800, accel: QemuGate::SUITE_ACCELERATOR, cpus: 1, jobs: 4,
                  suites: ['fast'] }
      OptionParser.new do |flags|
        flags.on('--out DIR', 'Directory for the trees, images, serial logs, event streams and reports') { |value| options[:out] = value }
        flags.on('--deadline SECONDS', Integer, 'Hard deadline of each run') { |value| options[:deadline] = value }
        flags.on('--accel NAME', %w[tcg hvf], 'Accelerator') { |value| options[:accel] = value }
        flags.on('--cpus N', Integer, 'Guest CPUs') { |value| options[:cpus] = value }
        flags.on('--jobs N', Integer, 'Build jobs') { |value| options[:jobs] = value }
        suites_option(flags, options)
      end.parse!(arguments)
      selection = oracle_selection(arguments, options)
      oracle_groups(selection, out: options[:out]) do |group, suites, out|
        outcome = qemu_class.new(root: ROOT, out: out, deadline: options[:deadline], group: group)
                            .run(suites, accel: options[:accel], cpus: options[:cpus], jobs: options[:jobs])
        Terminal.puts("#{group}: guest #{options[:accel]} #{options[:cpus]} CPU, #{outcome.seconds ? "#{outcome.seconds.round} s" : 'unknown'}")
        outcome.result
      end
    end

    def self.suites_option(flags, options)
      flags.on('--suites LIST', Array, 'Groups, group/SUITEs or fast, comma-separated') { |value| options[:suites] = value }
    end

    # The groups and suites `options[:suites]` names, once the options are
    # checked and no argument is left over.
    def self.oracle_selection(arguments, options)
      raise OptionParser::InvalidArgument, "unexpected arguments: #{arguments.join(' ')}" unless arguments.empty?
      raise OptionParser::InvalidArgument, 'deadline must be between 60 and 86400 seconds' unless options[:deadline].between?(60, 86_400)

      OracleSuites.select(options[:suites], root: ROOT)
    rescue Error => error
      raise OptionParser::InvalidArgument, error.message
    end

    # Runs each group of `selection` in turn, in `out/<group>`, through the
    # block, which returns the group's comparison; then prints and writes the
    # combined report. The exit is 0 only when every group passed.
    def self.oracle_groups(selection, out:)
      results = selection.to_h { |group, suites| [group, yield(group, suites, File.join(out, group))] }
      report = File.join(FileUtils.mkdir_p(out).first, 'report.txt')
      File.write(report, OracleSuites.combined_report(results))
      File.read(report).each_line { |line| Terminal.puts(line.chomp) }
      Terminal.puts("report: #{report}")
      results.values.all?(&:passed?) ? 0 : 1
    end

    # The bootable file on the stopgap: good images in both forms under HVF, as
    # the gate's boot_image suite runs them, and each damage the boot checks
    # claim to catch.
    def self.check_boot_image(input_arguments)
      arguments = input_arguments.dup
      accels = [QemuGate::SUITE_ACCELERATOR]
      jobs = 8
      OptionParser.new do |flags|
        flags.on('--jobs N', Integer, 'Build jobs') { |value| jobs = value }
      end.parse!(arguments)
      raise OptionParser::InvalidArgument, 'unexpected arguments' unless arguments.empty?

      runner = Runner.new(owner_root: ROOT, log_dir: File.join(ROOT, 'build/logs'))
      report = BootImageCheck::Run.new(root: ROOT, runner: runner, compiler: ENV.fetch('ERX_CLANG', ''),
                                       linker: ENV.fetch('ERX_LLD', '')).call(accels: accels, jobs: jobs)
      report.fetch(:good).each do |label, run|
        Terminal.puts("boot image #{label}: boots in #{run.fetch(:seconds).round(3)} s; #{run.fetch(:serial)}")
      end
      report.fetch(:refused).each { |name, serial| Terminal.puts("boot image refused: #{name}; #{serial}") }
      0
    end

    # The debug-log probe on the stopgap kernel under HVF, as the gate runs it, each
    # transcript compared with the hosted backend's and the expected one.
    def self.check_debug_log(input_arguments)
      arguments = input_arguments.dup
      accels = [QemuGate::SUITE_ACCELERATOR]
      jobs = 8
      OptionParser.new do |flags|
        flags.on('--jobs N', Integer, 'Build jobs') { |value| jobs = value }
      end.parse!(arguments)
      raise OptionParser::InvalidArgument, 'unexpected arguments' unless arguments.empty?

      DebugLogProbe::Run.new(root: ROOT).call(accels: accels, jobs: jobs).each do |label, run|
        Terminal.puts("debug-log probe #{label}: agrees with hosted; image #{run.fetch(:image_sha256)}; #{run.fetch(:serial)}")
      end
      0
    end

    # Every QEMU suite, discovered from tools/lib/erx/qemu_suites/, under HVF,
    # and under TCG the two things only TCG can do (QemuGate::SMOKE_ACCELERATOR).
    # Exits 0 only when no suite failed or went incomplete. A host whose QEMU
    # lacks either accelerator fails before anything is built: the gate never
    # falls back to the other one. `--suite NAME`, given once or more, runs only
    # those suites, for a change that touches them; the gate's verdict needs all.
    def self.check_qemu(input_arguments, runner_class: Runner, fiasco_class: Fiasco)
      arguments = input_arguments.dup
      options = { jobs: 8, suites: [] }
      OptionParser.new do |flags|
        flags.on('--jobs N', Integer, 'Build jobs') { |value| options[:jobs] = value }
        flags.on('--suite NAME', 'Run only this suite; repeatable') { |value| options[:suites] << value }
      end.parse!(arguments)
      raise OptionParser::InvalidArgument, 'unexpected arguments' unless arguments.empty?

      suites = QemuGate.suites
      unless options[:suites].empty?
        unknown = options[:suites] - suites.map(&:name)
        raise OptionParser::InvalidArgument, "unknown suites: #{unknown.join(' ')}" unless unknown.empty?

        suites = suites.select { |suite| options[:suites].include?(suite.name) }
      end

      runner = runner_class.new(owner_root: ROOT, log_dir: File.join(ROOT, 'build/logs'))
      available = QemuGate.available_accelerators(runner: runner)
      missing = QemuGate::REQUIRED_ACCELERATORS - available.to_a
      unless missing.empty?
        Terminal.puts("qemu gate: failed; this host's QEMU does not offer #{missing.join(' and ')}, " \
                      "which the gate needs (offered: #{available.to_a.sort.join(' ')})")
        return 1
      end
      fiasco_class.new(root: ROOT, runner: runner).build(jobs: options.fetch(:jobs))
      results = QemuGate.run(suites: suites, context: QemuGate::Context.new(root: ROOT, jobs: options.fetch(:jobs)))
      QemuGate.table(results).each { |line| Terminal.puts(line) }
      QemuGate.overall(results.values.map { |entry| QemuGate.status(entry) }) == 'passed' ? 0 : 1
    end

    # The conformance roster under HVF at each CPU count, as the gate runs it.
    # Succeeds only when every configuration passed; an unsupported, partial
    # or timed-out configuration leaves the matrix incomplete.
    def self.conformance(input_arguments)
      arguments = input_arguments.dup
      options = { image: Fiasco.new(root: ROOT).image_path, roster: File.join(ROOT, 'test/conformance/roster.txt'),
                  accels: [QemuGate::SUITE_ACCELERATOR], cpus: [1, 4] }
      OptionParser.new do |flags|
        flags.on('--image PATH', 'Explicit built guest image') { |value| options[:image] = value }
        flags.on('--roster PATH', 'Conformance roster') { |value| options[:roster] = value }
        flags.on('--cpus LIST', Array, 'CPU counts') do |value|
          options[:cpus] = value.map { |cpus| Integer(cpus, exception: false) || raise(OptionParser::InvalidArgument, cpus) }
        end
      end.parse!(arguments)
      raise OptionParser::InvalidArgument, 'unexpected arguments' unless arguments.empty?
      roster = Conformance.roster(BoundedFile.read(options.fetch(:roster), maximum: 1 << 20),
                                  path: options.fetch(:roster))
      configs = options.fetch(:accels).product(options.fetch(:cpus)).map do |accel, cpus|
        Conformance::Config.new(accel: accel, cpus: cpus)
      end
      matrix = Conformance::Run.new(root: ROOT).run(image: options.fetch(:image), roster: roster, configs: configs)
      Conformance.table(matrix).each { |line| Terminal.puts(line) }
      matrix.fetch('status') == 'passed' ? 0 : 1
    end

    def self.bench(input_arguments)
      arguments = input_arguments.dup
      name = arguments.shift
      options = {}
      OptionParser.new do |flags|
        flags.on('--flavour NAME', %w[emu jit]) { |value| options[:flavour] = value }
        flags.on('--iterations N', Integer, 'host benchmarks only') { |value| options[:iterations] = value }
        flags.on('--samples N', Integer, 'host benchmarks only') { |value| options[:samples] = value }
        flags.on('--image PATH', 'g3 only: boot this built image instead of building one') { |value| options[:image] = value }
        flags.on('--accel NAME', %w[tcg hvf], 'g3 only: the guest accelerator') { |value| options[:accel] = value }
      end.parse!(arguments)
      raise OptionParser::InvalidArgument, 'unexpected arguments' unless arguments.empty?

      inapplicable = name == 'g3' ? %i[iterations samples] : %i[image accel]
      refused = inapplicable.select { |option| options.key?(option) }
      unless refused.empty?
        raise OptionParser::InvalidArgument, "#{refused.map { |option| "--#{option}" }.join(', ')} do not apply to bench #{name}"
      end
      return bench_g3(options) if name == 'g3'

      report = Bench.new(root: ROOT).run(name, flavour: options.fetch(:flavour, 'emu'),
                                         iterations: options.fetch(:iterations, 10_000),
                                         samples: options.fetch(:samples, 7))
      Terminal.puts("native host benchmark: #{report.fetch('report')}")
      0
    end

    # Gate G3: erXos under QEMU and on stock OTP on this host (docs/research-g3-baseline.md).
    # The report is written however far the guest got; the exit status is nonzero unless every
    # workload was measured.
    def self.bench_g3(options)
      raise OptionParser::MissingArgument, '--accel' unless options[:accel]

      report = BenchG3.new(root: ROOT).run(accel: options.fetch(:accel), flavour: options.fetch(:flavour, 'emu'),
                                           image: options[:image])
      Terminal.puts("G3 benchmark (#{options.fetch(:accel)}): #{report.fetch('report')}")
      statuses = report.fetch('comparison').map { |workload, entry| "#{workload} #{entry.fetch('status')}" }
      Terminal.puts("G3 workloads: #{statuses.join(', ')}")
      report.fetch('complete') ? 0 : 1
    end

    def self.status(arguments, directories: Dir)
      raise OptionParser::InvalidArgument, 'unexpected arguments' unless arguments.empty?

      records = directories.glob(File.join(ROOT, 'build/logs/*.json')).sort.map do |path|
        status_record(BoundedFile.read(path, maximum: 65_536))
      end
      active = records.select { |record| record.fetch('state') == 'running' }
      active.each do |record|
        age = Time.now - record.fetch('started_at')
        Terminal.puts("recorded running (liveness unknown) #{record.fetch('argv').first}: age #{age.round}s, " \
                      "deadline #{record.fetch('deadline_seconds')}s; #{record.fetch('log')}")
      end
      Terminal.puts('no commands recorded as running') if active.empty?
      0
    end

    def self.status_record(bytes)
      record = JsonInput.parse(bytes, max_bytes: 65_536, label: 'runner status record')
      unless record.is_a?(Hash) &&
             %w[running succeeded failed timed_out cancelled setup_error].include?(record['state']) &&
             record['argv'].is_a?(Array) && record['argv'].size.between?(1, 1024) &&
             record['argv'].all? { |value| value.is_a?(String) && value.bytesize <= 4096 && !value.include?("\0") } &&
             record['started_at'].is_a?(String) &&
             /\A[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z\z/.match?(record['started_at']) &&
             record['deadline_seconds'].is_a?(Integer) && record['deadline_seconds'].between?(1, 86_400) &&
             record['log'].is_a?(String) && record['log'].bytesize.between?(1, 4096) && !record['log'].include?("\0")
        raise Error, 'invalid runner status record fields'
      end
      record.merge('started_at' => Time.iso8601(record.fetch('started_at'))).freeze
    rescue ArgumentError
      raise Error, 'invalid runner status record start time'
    end

    def self.check_tla(input_arguments)
      arguments = input_arguments.dup
      filter = nil
      no_cache = ENV['TLA_NO_CACHE'] == '1'
      parser = OptionParser.new do |options|
        options.on('--filter TEXT', 'Select configuration ids containing this text') { |value| filter = value }
        options.on('--no-cache', 'Check without reusing earlier evidence') { no_cache = true }
      end
      parser.parse!(arguments)
      raise OptionParser::InvalidArgument, 'unexpected arguments' unless arguments.empty?
      Tla.new(root: ROOT).run(filter: filter, no_cache: no_cache)
      0
    end

