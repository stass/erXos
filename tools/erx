      request = InteractiveBoot.request(arguments)
      runner = runner_class.new(owner_root: ROOT, log_dir: File.join(ROOT, 'build/logs'))
      accel = request.accel || InteractiveBoot.default_accel(QemuGate.available_accelerators(runner: runner))
      Terminal.puts("building the development boot image into #{InteractiveBoot::DIRECTORY}")
      image = InteractiveBoot.build_image(root: ROOT, runner: runner, jobs: request.jobs)
      argv = InteractiveBoot.argv(accel: accel, cpus: request.cpus, image: image)
      Terminal.puts("booting: accelerator #{accel}, #{request.cpus} guest CPU(s); #{InteractiveBoot::QUIT_HINT}")
      InteractiveBoot.run(argv)
    end

    # One boot of the built kernel image, its serial output in a log: under HVF
    # when this host's QEMU offers it, as `boot` chooses, unless --accel names one.
    def self.qemu(input_arguments)
      arguments = input_arguments.dup
      options = { image: Fiasco.new(root: ROOT).image_path }
      parser = OptionParser.new do |flags|
        flags.on('--accel NAME', %w[tcg hvf], 'Guest accelerator') { |value| options[:accel] = value }
        flags.on('--image PATH', 'Explicit built guest image') { |value| options[:image] = value }
        flags.on('--cpus N', Integer, 'Guest CPUs') { |value| options[:cpus] = value }
        flags.on('--memory-mib N', Integer, 'Guest RAM in MiB') { |value| options[:memory_mib] = value }
      end
      parser.parse!(arguments)
      raise OptionParser::InvalidArgument, 'unexpected arguments' unless arguments.empty?
