                      '--seed', options.fetch(:seed).to_s],
                     name: "fuzz-erx-net-#{target}", deadline: 900, chdir: ROOT, env: environment)
        end
      end
      require_relative 'fuzz/run_pack'
      Terminal.puts('implemented ABI, manifest and host metadata parser fuzz targets passed')
      Terminal.puts("native fuzz targets passed: #{PackFuzz.targets.map(&:kind).join(' ')}")
      Terminal.puts('pack/terminal/export Ruby targets: fixed 20000 iterations, seed 1; ' \
                    'native C seeds are recorded in logs')
      Terminal.puts('root-startup and target runtime/service parsers: unsupported until their implementations land')
      0
    end

    def self.fuzz_c(runner:, environment:, runs:, seed:)
      require_relative 'fuzz/run_pack'
      FuzzWorkspace.run(root: ROOT, name: 'abi', maximum_input: 65_536) do |directory, artifacts|
        corpus = File.join(directory, 'corpus')
        Dir.mkdir(corpus, 0o700)
        program = File.join(directory, 'abi-fuzz')
        runner.run([RbConfig.ruby, File.join(ROOT, 'test/fuzz/abi_corpus.rb'), corpus],
                   name: 'abi-fuzz-corpus', deadline: 30, chdir: ROOT, env: environment)
        runner.run([environment.fetch('ERX_CLANG'), '-std=c17', '-Wall', '-Wextra', '-Werror', '-pedantic',
                    '-O1', '-g', '-fsanitize=fuzzer,address,undefined', '-fno-omit-frame-pointer',
                    *Generated.include_flags(root: ROOT), '-I', File.join(ROOT, 'include'), '-I', ROOT,
                    Generated.path('liberx/generated/abi_reader.c', root: ROOT),
                    Generated.path('kernel/generated/abi_decode.c', root: ROOT),
                    Generated.path('fuzz/generated/abi.c', root: ROOT), '-o', program],
                   name: 'compile-abi-fuzz', deadline: 90, chdir: ROOT, env: environment)
        runner.run([program, "-runs=#{runs}", "-seed=#{seed}", '-max_len=65536', '-timeout=5',
                    "-artifact_prefix=#{artifacts}/", corpus],
                   name: 'abi-fuzz', deadline: 180, chdir: ROOT, env: environment)
      end
      runner.run([RbConfig.ruby, File.join(ROOT, 'tools/fuzz/run_pack.rb')],
                 name: 'pack-elf-fuzz', deadline: PackFuzz.deadline, chdir: ROOT,
                 env: environment.merge('RUNS' => runs.to_s))
    end

    def self.fuzz_ruby(runner:, environment:, seconds:, seed:)
      %w[test/fuzz/abi.rb test/fuzz/qemu_transcript.rb test/fuzz/cli_status.rb tools/fuzz/oracle_results.rb tools/fuzz/crash_frame.rb
         tools/fuzz/boot_record.rb tools/fuzz/etf.rb tools/fuzz/hostlink_frame.rb
         tools/fuzz/line_escape.rb].each do |path|
        runner.run([RbConfig.ruby, File.join(ROOT, path), '--seconds', seconds.to_s, '--seed', seed.to_s],
                   name: "fuzz-#{File.basename(path, '.rb').tr('_', '-')}", deadline: seconds + 30,
                   chdir: ROOT, env: environment)
      end
      %w[pack_host_fuzz terminal_rules_fuzz oracle_export_fuzz].each do |name|
        runner.run([RbConfig.ruby, File.join(ROOT, "tools/fuzz/#{name}.rb")],
                   name: name.tr('_', '-'), deadline: 180, chdir: ROOT, env: environment)
      end
      require_relative 'fuzz/host_metadata'
      HostMetadataFuzz::TARGETS.each do |target|
        runner.run([RbConfig.ruby, File.join(ROOT, 'tools/fuzz/host_metadata.rb'), '--target', target,
                    '--seconds', seconds.to_s, '--seed', seed.to_s],
                   name: "fuzz-#{target.tr('_', '-')}", deadline: seconds + 30,
                   chdir: ROOT, env: environment)
      end
    end

    # Builds Fiasco and packs the production image into a fresh directory of build/; with
    # --medium, also the release medium for QEMU that holds it (ReleaseMedium).
    def self.pack(arguments)
      medium = false
      OptionParser.new { |flags| flags.on('--medium') { medium = true } }.parse!(arguments)
      no_arguments(arguments)
      require_relative 'lib/erx/production_image'
      runner = Runner.new(owner_root: ROOT, log_dir: File.join(ROOT, 'build/logs'))
      environment = host_environment(runner: runner)
      compiler = environment.fetch('ERX_CLANG')
      fiasco = Fiasco.new(root: ROOT, runner: runner, compiler: compiler)
      fiasco.build(jobs: 4)
      parent = File.join(ROOT, 'build/production-image')
      OutputDirectory.prepare(root: ROOT, path: parent)
      image = ProductionImage.new(root: ROOT, runner: runner, compiler: compiler, linker: environment.fetch('ERX_LLD'), fiasco: fiasco)
      directory = Dir.mktmpdir('image-', parent)
      unless medium
        built = image.build(directory: directory)
        Terminal.puts("production image: #{built.single}; root_startup: #{built.report.fetch('manifest').fetch('root_startup')}")
        return 0
      end

      built, written = image.build_medium(directory: directory)
      Terminal.puts("production image: #{built.single}; root_startup: #{built.report.fetch('manifest').fetch('root_startup')}")
      extents = written.slot.images.map do |extent|
        "#{extent.file.name} at slot byte #{extent.slot_offset}, #{extent.file.length} bytes"
      end
      Terminal.puts("release medium: #{written.path}; EROFS image: #{written.erofs}; #{extents.join('; ')}")
      0
    end

