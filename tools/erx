    # tools/erx sysreg refresh [--verify] [--root PATH]: the one reader of Arm's
    # fetched archive. It rewrites hw/sysreg/aarch64.json from the pinned
    # Registers.json, or with --verify only compares; no gate runs it.
    def self.sysreg(input_arguments)
      arguments = input_arguments.dup
      verify = false
      root = ROOT
      parser = OptionParser.new do |options|
        options.banner = 'usage: tools/erx sysreg refresh [--verify] [--root PATH]'
        options.on('--verify', "Compare with Arm's pinned source without writing") { verify = true }
        options.on('--root PATH', 'Tree to refresh (default: this checkout)') { |path| root = File.expand_path(path) }
      end
      parser.parse!(arguments)
      raise OptionParser::InvalidArgument, parser.banner unless arguments == ['refresh']

      if verify
        Sysreg.verify(root: root)
        Terminal.puts("#{Sysreg::SPECIFICATION} matches Arm's pinned source")
      else
        changed = Sysreg.refresh(root: root)
        Terminal.puts("#{Sysreg::SPECIFICATION} #{changed ? 'rewritten' : 'unchanged'} from Arm's pinned source")
      end
      0
    end

    # Runs musl's libc-test in tasks on one accelerator and CPU count: tools/erx check-libc-test ACCEL CPUS.
    # It fails on any result that differs from its line in test/conformance/libc-test-verdicts.txt,
    # and on a boot that leaked the pool or never said whether it did.
    def self.check_libc_test(arguments)
      accel, cpus = arguments
      raise OptionParser::InvalidArgument, 'check-libc-test ACCEL CPUS' unless arguments.size == 2 && cpus.match?(/\A[1-9][0-9]*\z/)

      require_relative 'lib/erx/libc_test'
      verdicts = LibcTest.load_verdicts(ROOT)
      outcome = LibcTest::Run.new(root: ROOT).call(accel: accel, cpus: cpus.to_i)
      Terminal.puts("#{outcome.fetch(:report)}: #{outcome.fetch(:totals)}; pool leaks in boots " \
                    "#{outcome.fetch(:pool_leaks_in_boots)}, unknown in boots #{outcome.fetch(:pool_unknown_in_boots)}")
      problems = LibcTest.check_problems(outcome, verdicts: verdicts)
      problems.each { |problem| Terminal.puts("libc-test: #{problem}") }
      problems.empty? ? 0 : 1
    end

    # The suites the system domain runs under HVF, compared with stock: OTP's
    # four groups of docs/plan.md's M3 (OracleSuites::GROUPS) whole, then
    # musl's libc-test in test tasks on LIBC_TEST_CPUS CPUs. It exits 0 when
    # every part passed, and 1 when a part failed or this host's QEMU does
    # not offer HVF.
    LIBC_TEST_CPUS = 4
    # Each side's deadline: stock, the slower side, runs the emulator group in
    # about 6,000 s and the kernel group in about 6,700 s at the guest's one
    # scheduler (erxos-history oracle-qemu/emulator/2026-11-07,
    # oracle-qemu/kernel/2026-11-07-whole, both on a loaded host).
    ORACLE_DEADLINE = 10_800

    def self.check_oracle(arguments, qemu_class: OracleQemu, accelerators: nil, libc_test: method(:check_libc_test))
      no_arguments(arguments)
      offered = accelerators || QemuGate.available_accelerators(runner: Runner.new(owner_root: ROOT, log_dir: File.join(ROOT, 'build/logs')))
      accel = QemuGate::SUITE_ACCELERATOR
      unless offered.include?(accel)
        Terminal.puts("failed: this host's QEMU does not offer #{accel}, which the oracle run needs")
        return 1
      end
      status = oracle_qemu(['--accel', accel, '--out', File.join(ROOT, "build/check-oracle/#{accel}"), '--deadline', ORACLE_DEADLINE.to_s,
                            '--suites', OracleSuites::GROUPS.keys.join(',')], qemu_class: qemu_class)
      Terminal.puts("oracle qemu #{accel}: #{status.zero? ? 'passed' : 'failed'}")
      libc = libc_test.call([accel, LIBC_TEST_CPUS.to_s])
      Terminal.puts("libc-test #{accel} #{LIBC_TEST_CPUS} CPUs: #{libc.zero? ? 'passed' : 'failed'}")
      status.zero? && libc.zero? ? 0 : 1
    end

    # tools/erx load and watch (CodeCommands), with the oracle's erlc for sources.
    def self.code_command(command, arguments)
      compile = ErlangCompile.for_tree(root: ROOT)
      CodeCommands.public_send(command, arguments, connect: CodeCommands.method(:connect_socket), compile: compile,
                                                   out: Terminal.method(:puts))
    end

    # tools/erx files --socket PATH --listen SOCK [--build HEX] [--once]: relays the UNIX
    # socket SOCK, in an owner-only directory, to the host link's files stream of the guest
    # whose host link socket is PATH (FilesRelay); --once serves one client and exits.
    def self.files_command(arguments)
      options = { once: false }
      OptionParser.new do |flags|
        flags.on('--socket PATH') { |value| options[:socket] = value }
        flags.on('--listen SOCK') { |value| options[:listen] = value }
        flags.on('--build HEX', /\A\h+\z/) { |value| options[:build] = value.downcase }
        flags.on('--once') { options[:once] = true }
      end.parse!(arguments)
      no_arguments(arguments)
      raise OptionParser::InvalidArgument, 'files needs --socket PATH and --listen SOCK' unless
        options[:socket] && options[:listen]

      require_relative 'lib/erx/files_relay'
      UNIXSocket.open(options.fetch(:socket)) do |io|
        link = HostlinkClient.new(io: io, expected_build: options[:build])
        FilesRelay.new(link: link, listen: options.fetch(:listen), out: Terminal.method(:puts))
                  .serve(connections: options[:once] ? 1 : nil)
      end
      0
    end

    # tools/erx netboot [--tftp DIR] [--platform NAME]: stages the boot files of the board's
    # packed card (tools/erx pack --medium --platform NAME) into DIR, the TFTP root its
    # firmware boots from over the network (Netboot), and prints the build it staged and
    # the command line that serves DIR over TFTP (docs/design-platforms.md, "Netbooting
    # from a Mac").
    #
    # tools/erx netboot --key FILE [--http DIR] [--platform NAME]: the HTTP form, for a
    # bootloader that fetches boot.sig and boot.img (docs/design-platforms.md, "The HTTP
    # form"): stages the same boot files as a queue of one signed entry at DIR, a link,
    # signed with the RSA-2048 key FILE, which never leaves it. tools/erx netboot serve
    # serves DIR.
    def self.netboot_command(arguments)
      require 'etc'
      require_relative 'lib/erx/netboot'
      require_relative 'lib/erx/production_image'
      return netboot_serve(arguments.drop(1)) if arguments.first == 'serve'

      tftp = nil
      http = nil
      key = nil
      name = Netboot::PLATFORM
      OptionParser.new do |flags|
        flags.on('--tftp DIR') { |value| tftp = value }
        flags.on('--http DIR') { |value| http = value }
        flags.on('--key FILE') { |value| key = value }
        flags.on('--platform NAME') { |value| name = value }
      end.parse!(arguments)
      no_arguments(arguments)
      raise Error, 'netboot: --http stages for the HTTP form, which takes its signing key by --key FILE' if http && !key
      raise Error, 'netboot: --key signs for the HTTP form, which --tftp does not serve' if tftp && key

      platform = Platform.load(root: ROOT, name: name)
      raise Error, "netboot: #{name}'s firmware boots from no boot partition, so it has no network boot root" unless
        BootPartition.boot_partition_medium?(platform)

      medium = File.join(ROOT, ProductionImage.packed_directory(platform))
      return netboot_http(medium: medium, root: http || Netboot::DEFAULT_HTTP_ROOT, key: key, name: name) if key

      staged = Netboot.stage(medium: medium, root: tftp || Netboot::DEFAULT_ROOT)
      tree = case staged.dirty
             in true then 'with changes'
             in false then 'unchanged'
             in nil then 'not a git checkout'
             end
      server = Netboot.server_command(root: staged.root, interface: 'INTERFACE', user: Etc.getpwuid(Process.uid).name,
                                      group: Etc.getgrgid(Process.gid).name)
      Terminal.puts("netboot: #{staged.root} serves #{name}'s boot files of commit #{staged.commit || 'unknown'} " \
                    "(tree #{tree}), #{BootPartition::KERNEL} SHA-256 #{staged.kernel}")
      Terminal.puts("netboot: serve it over TFTP with this line, INTERFACE being the Mac's interface on the cable " \
                    '(with Internet Sharing on, the bridge ifconfig shows with the shared address, often bridge100):')
      Terminal.puts("  #{Netboot.shell_line(server)}")
      0
    end

    def self.netboot_http(medium:, root:, key:, name:)
      require_relative 'lib/erx/fsimg'
      staged = Netboot.stage_http(medium: medium, root: root, key: key, fsimg: Fsimg.locate(root: ROOT),
                                  runner: Runner.new(owner_root: ROOT, log_dir: File.join(ROOT, 'build/logs')))
      Terminal.puts("netboot: #{staged.root} serves #{name}'s boot files of commit #{staged.commit || 'unknown'} " \
                    "as one signed entry, #{BootPartition::KERNEL} SHA-256 #{staged.kernel}")
      Terminal.puts("netboot: serve it with: tools/erx netboot serve --http #{Netboot.shell_line([staged.root])}")
      0
    end

    # tools/erx netboot serve [--http DIR] [--bind ADDR] [--port N] [--prefix NAME]: the
    # HTTP form's boot server (NetbootServer), answering /NAME/boot.sig and /NAME/boot.img
    # of the queue the link DIR names, and nothing else, at ADDR:N, one connection at a
    # time, until interrupted. ADDR is by default Internet Sharing's address on the Mac's
    # side of the cable and NAME the EEPROM's HTTP_PATH.
    def self.netboot_serve(arguments)
      require_relative 'lib/erx/netboot_server'
      http = Netboot::DEFAULT_HTTP_ROOT
      bind = NetbootServer::Server::BIND
      port = 8080
      prefix = 'erxos'
      OptionParser.new do |flags|
        flags.on('--http DIR') { |value| http = value }
        flags.on('--bind ADDR') { |value| bind = value }
        flags.on('--port N', Integer) { |value| port = value }
        flags.on('--prefix NAME') { |value| prefix = value }
      end.parse!(arguments)
      no_arguments(arguments)
      link = File.expand_path(http)
      server = NetbootServer::Server.new(queue: NetbootServer::LinkQueue.new(link), prefix: prefix,
                                         log: ->(line) { Terminal.puts("netboot serve: #{line}") })
      listener = begin
        TCPServer.new(bind, port)
      rescue SystemCallError => e
        raise Error, "netboot serve: cannot listen on #{bind}:#{port}: #{e.class.name.split('::').last} " \
                     "(with Internet Sharing on, the bridge on the cable holds #{NetbootServer::Server::BIND})"
      end
      Terminal.puts("netboot serve: answering http://#{bind}:#{port}/#{prefix}/boot.sig and boot.img from the queue #{link} names")
      trap('INT') { exit(0) }
      server.listen(listener)
      0
    end

    # The seconds each call on the web facet may take; past them the host link is taken
    # as down, and every WebSocket closes.
    WEB_CALL_SECONDS = 10

    # tools/erx web --socket PATH [--build HEX] [--port N]: serves the web client from
    # build/web on the loopback address and relays its WebSockets to the host link's web
    # facet of the guest whose host link socket is PATH (docs/design-web.md, "The host
    # tool's front end"). Prints the one URL a browser may start from; runs until
    # interrupted.
    def self.web_command(arguments)
      options = { port: 0 }
      OptionParser.new do |flags|
        flags.on('--socket PATH') { |value| options[:socket] = value }
        flags.on('--build HEX', /\A\h+\z/) { |value| options[:build] = value.downcase }
        flags.on('--port N', Integer) { |value| options[:port] = value }
      end.parse!(arguments)
      no_arguments(arguments)
      raise OptionParser::InvalidArgument, 'web needs --socket PATH' unless options[:socket]
      raise OptionParser::InvalidArgument, 'web --port is 0 to 65535' unless options[:port].between?(0, 65_535)

      require_relative 'lib/erx/web_server'
      inventory = Web::Inventory.load(File.join(ROOT, 'build/web'))
      UNIXSocket.open(options.fetch(:socket)) do |io|
        relay = Web::Relay.new(link: HostlinkClient.new(io: io, expected_build: options[:build], deadline: WEB_CALL_SECONDS))
        relay.open
        server = Web::Server.new(relay: relay, inventory: inventory, port: options[:port], out: Terminal.method(:puts))
        %w[INT TERM].each { |signal| Signal.trap(signal) { server.stop } }
        Terminal.puts("web: open #{server.url}")
        server.serve
      end
      0
    end

    # tools/erx sdk export DIR: the SDK, written from the tree (Erx::Sdk).
    def self.sdk(arguments)
      raise OptionParser::InvalidArgument, 'usage: tools/erx sdk export DIR' unless arguments.size == 2 && arguments.first == 'export'

      require_relative 'lib/erx/sdk'
      runner = Runner.new(owner_root: ROOT, log_dir: File.join(ROOT, 'build/logs'))
      erlc = File.join(File.dirname(Oracle.new(root: ROOT, runner: runner).erl_path(Runtime::HOST_OTP_FLAVOUR)), 'erlc')
      sdk = Sdk.new(root: ROOT, runner: runner, erlc: erlc, compiler: ENV.fetch('ERX_CLANG', ''), linker: ENV.fetch('ERX_LLD', ''))
      Terminal.puts("exported #{sdk.export(arguments.last)}")
      0
    end

