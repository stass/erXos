    # A runtime that is not built, or is older than the tree, fails here: nothing
    # was read, so nothing passed.
    def self.check_runtime_seam(arguments, **)
      raise OptionParser::InvalidArgument, 'unexpected arguments' unless arguments.empty?

      output = Runtime.output(root: ROOT)
      report = Runtime.reading(root: ROOT) do
        Runtime.check_current(root: ROOT)
        RuntimeSeam.check_objects(objects: RuntimeSeam.objects(output), executable: output.beam, liberx: output.liberx,
                                  imports_path: File.join(output.root, RuntimeSeam::IMPORTS_FILE))
      end
      report.violations.each { |violation| Terminal.puts("#{violation.object}: imports #{violation.name}") }
      Terminal.puts("listed and imported by nothing: #{report.unused.join(' ')}") unless report.unused.empty?
      report.violations.empty? ? 0 : 1
    end

