    def self.build(input_arguments)
      arguments = input_arguments.dup
      component = arguments.shift
      raise OptionParser::InvalidArgument, 'build currently accepts fiasco' unless component == 'fiasco'
      jobs = 4
      parser = OptionParser.new do |options|
        options.on('--jobs N', Integer, 'Parallel inherited build jobs') { |value| jobs = value }
      end
      parser.parse!(arguments)
      raise OptionParser::InvalidArgument, 'unexpected arguments' unless arguments.empty?
      path = Fiasco.new(root: ROOT).build(jobs: jobs)
      Terminal.puts("built #{path}")
      0
    end

    def self.qemu(input_arguments)
      arguments = input_arguments.dup
      options = { accel: 'tcg', image: Fiasco.new(root: ROOT).image_path }
      parser = OptionParser.new do |flags|
        flags.on('--accel NAME', %w[tcg hvf], 'Guest accelerator') { |value| options[:accel] = value }
        flags.on('--image PATH', 'Explicit built guest image') { |value| options[:image] = value }
        flags.on('--cpus N', Integer, 'Guest CPUs') { |value| options[:cpus] = value }
        flags.on('--memory-mib N', Integer, 'Guest RAM in MiB') { |value| options[:memory_mib] = value }
      end
      parser.parse!(arguments)
      raise OptionParser::InvalidArgument, 'unexpected arguments' unless arguments.empty?
      report = Qemu.new(root: ROOT).run(**options)
      Terminal.puts("#{options.fetch(:accel)}: #{report.fetch('state')}; #{report.fetch('serial_log')}")
      0
    end

    def self.fetch(input_arguments)
      arguments = input_arguments.dup
      cache = nil
      source_id = nil
      docker_context = nil
      parser = OptionParser.new do |options|
        options.on('--cache DIRECTORY', 'Use only this explicit local source cache') { |value| cache = value }
        options.on('--source ID', 'Fetch only this pinned source') { |value| source_id = value }
        options.on('--docker-context NAME', 'Use this local Docker context for image fetch') { |value| docker_context = value }
      end
      parser.parse!(arguments)
      raise OptionParser::InvalidArgument, 'unexpected arguments' unless arguments.empty?

      runner = Runner.new(owner_root: ROOT, log_dir: File.join(ROOT, 'build/logs'))
      Dependencies.new(root: ROOT, runner: runner, docker_context: docker_context)
                  .fetch(cache: cache, source_id: source_id)
      Terminal.puts('sources verified and extracted')
      0
    end

    def self.oracle(input_arguments, native_class: Oracle, container_class: OracleContainer)
      arguments = input_arguments.dup
      action = arguments.shift
      unless %w[build run probe].include?(action)
        raise OptionParser::InvalidArgument, 'usage: oracle build|run SUITE|probe [--docker-context NAME] [--flavour emu|jit]'
      end
      suite = arguments.shift if action == 'run'
      options = { backend: 'linux', flavour: 'emu', jobs: 4, deadline: 14_400, clean: false }
      OptionParser.new do |flags|
        flags.on('--backend NAME', %w[linux native], 'Linux suites or native bootstrap build') { |value| options[:backend] = value }
        flags.on('--docker-context NAME', 'Explicit local Docker context; cached pinned image only') { |value| options[:context] = value }
        flags.on('--flavour NAME', %w[emu jit]) { |value| options[:flavour] = value }
        flags.on('--jobs N', Integer) { |value| options[:jobs] = value } unless action == 'probe'
        if action == 'run'
          flags.on('--deadline SECONDS', Integer, 'Suite hard deadline') { |value| options[:deadline] = value }
          flags.on('--suite NAME', 'Select one stock Common Test suite') { |value| options[:test_suite] = value }
          flags.on('--case NAME', 'Select a case within --suite') { |value| options[:testcase] = value }
        end
        if action == 'build'
          flags.on('--clean', 'Replace an existing native bootstrap build') { options[:clean] = true }
        end
      end.parse!(arguments)
      raise OptionParser::InvalidArgument, 'unexpected arguments' unless arguments.empty?
      unless options.fetch(:jobs).between?(1, 64)
        raise OptionParser::InvalidArgument, 'jobs must be between 1 and 64'
      end
      if options.fetch(:backend) == 'native'
        unless action == 'build' && !options[:context]
          raise OptionParser::InvalidArgument, 'native backend supports bootstrap build only, without Docker context'
        end
        native_class.new(root: ROOT).build(flavours: [options.fetch(:flavour)], jobs: options.fetch(:jobs), clean: options.fetch(:clean))
        Terminal.puts("native stock OTP bootstrap #{options.fetch(:flavour)} ready")
        return 0
      end
      raise OptionParser::InvalidArgument, '--clean applies to native bootstrap builds' if options.fetch(:clean)
      backend = container_class.new(root: ROOT, context: options[:context])
      result = case action
               when 'build'
                 backend.build(flavours: [options.fetch(:flavour)], jobs: options.fetch(:jobs)).first
               when 'probe'
                 backend.probe(flavour: options.fetch(:flavour))
               when 'run'
                 backend.run(suite, flavour: options.fetch(:flavour), jobs: options.fetch(:jobs),
                             deadline: options.fetch(:deadline), test_suite: options[:test_suite], testcase: options[:testcase])
               end
      Terminal.puts("Linux host oracle: #{result.fetch('state')}; #{result.fetch('report')}")
      result.fetch('state') == 'completed' || result.fetch('state') == 'ready' ? 0 : 1
    end

    # The conformance roster over the matrix of accelerators and CPU counts.
    # Succeeds only when every configuration passed; an unsupported, partial
    # or timed-out configuration leaves the matrix incomplete.
    def self.conformance(input_arguments)
      arguments = input_arguments.dup
      options = { image: Fiasco.new(root: ROOT).image_path, roster: File.join(ROOT, 'test/conformance/roster.txt'),
                  accels: %w[tcg hvf], cpus: [1, 4] }
      OptionParser.new do |flags|
        flags.on('--image PATH', 'Explicit built guest image') { |value| options[:image] = value }
        flags.on('--roster PATH', 'Conformance roster') { |value| options[:roster] = value }
        flags.on('--accel LIST', Array, 'Accelerators, of tcg and hvf') { |value| options[:accels] = value }
        flags.on('--cpus LIST', Array, 'CPU counts') do |value|
          options[:cpus] = value.map { |cpus| Integer(cpus, exception: false) || raise(OptionParser::InvalidArgument, cpus) }
        end
      end.parse!(arguments)
      raise OptionParser::InvalidArgument, 'unexpected arguments' unless arguments.empty?
      unless (options.fetch(:accels) - %w[tcg hvf]).empty? && !options.fetch(:accels).empty?
        raise OptionParser::InvalidArgument, 'accelerators must be tcg or hvf'
      end
      roster = Conformance.roster(BoundedFile.read(options.fetch(:roster), maximum: 1 << 20),
                                  path: options.fetch(:roster))
      configs = options.fetch(:accels).product(options.fetch(:cpus)).map do |accel, cpus|
        Conformance::Config.new(accel: accel, cpus: cpus)
      end
      matrix = Conformance::Run.new(root: ROOT).run(image: options.fetch(:image), roster: roster, configs: configs)
      Conformance.table(matrix).each { |line| Terminal.puts(line) }
      matrix.fetch('status') == 'passed' ? 0 : 1
    end

    def self.bench(input_arguments)
      arguments = input_arguments.dup
      name = arguments.shift
      options = { flavour: 'emu', iterations: 10_000, samples: 7 }
      OptionParser.new do |flags|
        flags.on('--flavour NAME', %w[emu jit]) { |value| options[:flavour] = value }
        flags.on('--iterations N', Integer) { |value| options[:iterations] = value }
        flags.on('--samples N', Integer) { |value| options[:samples] = value }
      end.parse!(arguments)
      raise OptionParser::InvalidArgument, 'unexpected arguments' unless arguments.empty?
      report = Bench.new(root: ROOT).run(name, **options)
      Terminal.puts("native host benchmark: #{report.fetch('report')}")
      0
    end

    def self.status(arguments, directories: Dir)
      raise OptionParser::InvalidArgument, 'unexpected arguments' unless arguments.empty?

      records = directories.glob(File.join(ROOT, 'build/logs/*.json')).sort.map do |path|
        status_record(BoundedFile.read(path, maximum: 65_536))
      end
      active = records.select { |record| record.fetch('state') == 'running' }
      active.each do |record|
        age = Time.now - record.fetch('started_at')
        Terminal.puts("recorded running (liveness unknown) #{record.fetch('argv').first}: age #{age.round}s, " \
                      "deadline #{record.fetch('deadline_seconds')}s; #{record.fetch('log')}")
      end
      Terminal.puts('no commands recorded as running') if active.empty?
      0
    end

    def self.status_record(bytes)
      record = JsonInput.parse(bytes, max_bytes: 65_536, label: 'runner status record')
      unless record.is_a?(Hash) &&
             %w[running succeeded failed timed_out cancelled setup_error].include?(record['state']) &&
             record['argv'].is_a?(Array) && record['argv'].size.between?(1, 1024) &&
             record['argv'].all? { |value| value.is_a?(String) && value.bytesize <= 4096 && !value.include?("\0") } &&
             record['started_at'].is_a?(String) &&
             /\A[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z\z/.match?(record['started_at']) &&
             record['deadline_seconds'].is_a?(Integer) && record['deadline_seconds'].between?(1, 86_400) &&
             record['log'].is_a?(String) && record['log'].bytesize.between?(1, 4096) && !record['log'].include?("\0")
        raise Error, 'invalid runner status record fields'
      end
      record.merge('started_at' => Time.iso8601(record.fetch('started_at'))).freeze
    rescue ArgumentError
      raise Error, 'invalid runner status record start time'
    end

    def self.check_tla(input_arguments)
      arguments = input_arguments.dup
      filter = nil
      no_cache = ENV['TLA_NO_CACHE'] == '1'
      parser = OptionParser.new do |options|
        options.on('--filter TEXT', 'Select configuration ids containing this text') { |value| filter = value }
        options.on('--no-cache', 'Check without reusing earlier evidence') { no_cache = true }
      end
      parser.parse!(arguments)
      raise OptionParser::InvalidArgument, 'unexpected arguments' unless arguments.empty?
      Tla.new(root: ROOT).run(filter: filter, no_cache: no_cache)
      0
    end

    private_class_method :generated, :host_environment, :with_test_runtime,
                         :run_tests, :fuzz_c, :fuzz_ruby, :no_arguments, :status_record
  end
end

exit(Erx::CLI.run(ARGV)) if $PROGRAM_NAME == __FILE__
