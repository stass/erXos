  module CLI
    def self.run(arguments, **collaborators)
      command, *command_arguments = arguments
      case command
      when 'check'
        check(command_arguments, **collaborators)
      when 'generate'
        generate(command_arguments, **collaborators)
      when 'check-reproducible'
        check_reproducible(command_arguments, **collaborators)
      when 'check-fuzz'
        check_fuzz(command_arguments, **collaborators)
      when 'check-sanitizers'
        check_sanitizers(command_arguments, **collaborators)
      when 'check-ubsan'
        status = check_sanitizers(command_arguments, **collaborators)
        Terminal.puts("kernel UBSan boot: unsupported; no UBSan trap-mode kernel build exists until erXos's own kernel does")
        status
      when 'gates'
        gates(command_arguments, **collaborators)
      when 'pack'
        pack(command_arguments, **collaborators)
      when 'sdk'
        sdk(command_arguments, **collaborators)
      when 'status'
        status(command_arguments, **collaborators)
      when 'setup'
        setup(command_arguments, **collaborators)
      when 'fetch'
        fetch(command_arguments, **collaborators)
      when 'check-tla'
        check_tla(command_arguments, **collaborators)
      when 'check-cbmc'
        check_cbmc(command_arguments, **collaborators)
      when 'check-litmus'
        no_arguments(command_arguments)
        check_litmus
      when 'check-sources'
        check_sources(command_arguments, **collaborators)
      when 'check-stack-proof'
        check_stack_proof(command_arguments, **collaborators)
      when 'sysreg'
        sysreg(command_arguments)
      when 'check-arch-terms'
        check_arch_terms(command_arguments, **collaborators)
      when 'check-fiasco-downsides'
        check_fiasco_downsides(command_arguments, **collaborators)
      when 'build'
        build(command_arguments, **collaborators)
      when 'check-runtime-seam'
        check_runtime_seam(command_arguments, **collaborators)
      when 'boot'
        boot(command_arguments, **collaborators)
      when 'ssh'
        ssh(command_arguments)
      when 'qemu'
        qemu(command_arguments, **collaborators)
      when 'conformance'
        conformance(command_arguments, **collaborators)
      when 'check-qemu'
        check_qemu(command_arguments, **collaborators)
      when 'check-boot-image'
        check_boot_image(command_arguments, **collaborators)
      when 'check-debug-log'
        check_debug_log(command_arguments, **collaborators)
      when 'oracle'
        oracle(command_arguments, **collaborators)
      when 'bench'
        bench(command_arguments, **collaborators)
      when 'check-libc-test'
        check_libc_test(command_arguments)
      when 'check-oracle'
        check_oracle(command_arguments, **collaborators)
      when 'load', 'watch'
        code_command(command, command_arguments)
      when 'files'
        files_command(command_arguments)
      when 'netboot'
        netboot_command(command_arguments)
      when 'web'
        web_command(command_arguments)
      when '--help', '-h', nil
        help(command_arguments, **collaborators)
      else
        raise OptionParser::InvalidArgument, "unknown command: #{command}"
      end
    rescue OptionParser::ParseError => error
      Terminal.puts(error.message)
      2
    rescue Error, SystemCallError => error
      Terminal.puts(error.message)
      1
    end

    def self.check(input_arguments, runner_class: Runner, checks_class: Checks, arch_terms: ArchTerms,
                   fiasco_downsides: FiascoDownsides,
                   runtime: method(:with_test_runtime), rc_oracle: method(:ensure_rc_oracle), web: WebBuild.method(:build),
                   platform: RUBY_PLATFORM)
      arguments = input_arguments.dup
      OptionParser.new.parse!(arguments)
      raise OptionParser::InvalidArgument, 'unexpected arguments' unless arguments.empty?

      runner = runner_class.new(owner_root: ROOT, log_dir: File.join(ROOT, 'build/logs'))
      checks_class.new(root: ROOT, runner: runner).run
      arch_terms.check(root: ROOT)
      fiasco_downsides.check(root: ROOT)
      web.call(root: ROOT, runner: runner)
      rc_oracle.call(runner: runner)
      left_out = []
      runtime.call(runner: runner) do |environment|
        stack_proof(runner: runner, environment: environment)
        tests = Dir.glob(File.join(ROOT, 'test/host/*_test.rb')).sort
        raise Error, 'no host tests found' if tests.empty?
        left_out = run_tests(tests, runner: runner, name: 'host-tests', environment: environment, platform: platform) +
                   run_tests(integration_tests(ROOT), runner: runner, name: 'native-integration',
                                     environment: environment, platform: platform)
      end
      Terminal.puts("offline source, generation, host and native integration checks passed#{not_run_note(left_out)}")
      0
    end

    # The command shell's integration tests (erx_shell_corpus, erx_shell_commands) run
    # against plan9port's rc, built on the host. `make setup` builds it, but a change to
    # its recipe or pin leaves that build stale, so check builds it again, from the
    # fetched pin and offline, whenever RcOracle.locate refuses what is there.
    def self.ensure_rc_oracle(runner:, root: ROOT, build_class: RcOracle::Build)
      RcOracle.locate(root: root)
    rescue RcOracle::MissingBuild, RcOracle::StaleBuild
      build_class.new(root: root, runner: runner).call
      RcOracle.locate(root: root)
    end

    # An integration test runs in `make check` unless it is excused here: these
    # rebuild Fiasco, boot it under QEMU, need the stock OTP
    # suites' runtime, need the hosted runtime built, or need Arm's register
    # archive fetched, or build OpenSSL. check ensures the rc oracle first (ensure_rc_oracle),
    # so the tests that read plan9port's rc run in it.
    STANDALONE_INTEGRATION_TESTS = %w[domain_image fiasco_reproducible libcrypto_build linux_guest_seed native_seeds oracle_ct_oracle oracle_reporter qemu_gate_mutant runtime_console runtime_device runtime_dirty_io_reductions runtime_eval_receive runtime_genet runtime_hosted_smoke runtime_literal_token runtime_prepare_loading runtime_prim_file runtime_release runtime_service_nifs sysreg_refresh oracle_log_tree].freeze

    def self.integration_tests(root)
      excused = STANDALONE_INTEGRATION_TESTS.map { |name| "#{name}_test.rb" }
      tests = Dir.glob('*_test.rb', base: File.join(root, 'test/integration')).sort - excused
      raise Error, 'no integration tests found' if tests.empty?

      tests.map { |test| File.join(root, 'test/integration', test) }
    end

    # Reports what bringing build/gen up to date did, which tools/erx does
    # before any command: regenerated, or found it current.
    def self.generate(arguments, tree: ENTRY_TREE)
      no_arguments(arguments)
      Terminal.puts("generated files in #{tree.output}: #{tree.status == :fresh ? 'up to date' : 'regenerated'}")
      0
    end

    # The clang and lld every build and test gate uses: ERX_CLANG and ERX_LLD,
    # an LLVM installation whose resource headers the reviewed LLVM profile
    # admits. An arbitrary compiler selected by PATH cannot stand in for it.
    def self.host_environment(runner:)
      compiler = ENV['ERX_CLANG']
      raise Error, 'set ERX_CLANG to an installed LLVM clang; see README.md' if !compiler || compiler.empty?
      compiler = File.realpath(compiler)
      raise Error, 'ERX_CLANG is not an executable compiler' unless File.file?(compiler) && File.executable?(compiler)
      # ERX_LLD as an absolute path, so every later step runs the same lld whatever
      # directory it starts in.
      linker = HostPath.find_linker(ENV.fetch('ERX_LLD', 'ld.lld'), compiler: compiler, path: ENV.fetch('PATH', ''))
      raise Error, 'ERX_LLD names no executable linker' unless linker

      resource = runner.run([compiler, '-print-resource-dir'], name: 'check-clang-resource', deadline: 30)
      ToolchainProvenance.llvm(root: ROOT, resource_dir: BoundedFile.read(resource.fetch('log'), maximum: 4096).strip)
      path = [File.dirname(compiler), ENV.fetch('PATH', '')].join(File::PATH_SEPARATOR)
      { 'ERX_CLANG' => compiler, 'CC' => compiler, 'ERX_LLD' => linker, 'PATH' => path }
        .merge(SanitizerEnvironment.call(compiler: compiler)).freeze
    end

    def self.with_test_runtime(runner:, oracle_class: Oracle, host_environment: method(:host_environment))
      environment = host_environment.call(runner: runner)
      oracle_class.new(root: ROOT, runner: runner).with_runtime('jit') do |runtime|
        yield Oracle::CLEAN_ERLANG_ENV.merge(environment)
                  .merge('ERX_ERL' => runtime.fetch('erl'), 'ERX_ERLC' => runtime.fetch('erlc')).freeze
      end
    end

    # Seconds one test file may run before it is killed. The slowest file takes
    # about 230 s under sanitizers on a loaded 16-CPU host, so this is about four
    # times that, and a hang costs one file's deadline, not the step's.
    TEST_FILE_DEADLINE = 900

    # Runs the files this host can run, each its own process under its own
    # deadline (see TestPool), and returns the ones it left out
    # (Runtime.host_test_plan), each named on the terminal before the rest
    # start, so the step's closing line counts them as not run, not passed.
    def self.run_tests(paths, runner:, name:, environment:, platform: RUBY_PLATFORM, deadline: TEST_FILE_DEADLINE)
      plan = Runtime.host_test_plan(paths, root: ROOT, platform: platform)
      plan.not_run.each { |entry| Terminal.puts("#{name}: #{entry.path}: not run on this host: #{entry.reason}") }
      # A step this host left wholly out has nothing to run, which is not the pool's empty-list error.
      unless plan.run.empty? && !plan.not_run.empty?
        TestPool.run(plan.run, runner: runner, name: name, environment: environment, deadline: deadline, root: ROOT)
      end
      plan.not_run
    end

    # The closing line's tail when files were left out: never silent about them.
    def self.not_run_note(not_run)
      not_run.empty? ? '' : "; #{not_run.size} test files not run on this host (listed above)"
    end

    # The production image and its medium, built twice and compared: QEMU virt's by
    # default, or with --platform NAME that board's.
    def self.check_reproducible(arguments)
      platform = platform_option(arguments)
      no_arguments(arguments)
      require_relative 'lib/erx/production_image'
      runner = Runner.new(owner_root: ROOT, log_dir: File.join(ROOT, 'build/logs'))
      environment = host_environment(runner: runner)
      compiler = environment.fetch('ERX_CLANG')
      fiasco = Fiasco.new(root: ROOT, runner: runner, compiler: compiler)
      fiasco.build_for(platform, jobs: 4)
      parent = File.join(ROOT, 'build/reproducible')
      OutputDirectory.prepare(root: ROOT, path: parent)
      report = ProductionImage.new(root: ROOT, runner: runner, compiler: compiler, linker: environment.fetch('ERX_LLD'),
                                   machine: ProductionImage::Machine.development(platform), fiasco: fiasco)
                              .check_reproducible(directory: Dir.mktmpdir('production-', parent))
      Terminal.puts("production image: byte-identical; #{report.fetch('report')}")
      Terminal.puts("child_plan_instances: #{report.fetch('manifest').fetch('child_plan_instances')}")
      0
    end

    def self.check_sanitizers(arguments, runner_class: Runner, runtime: method(:with_test_runtime), platform: RUBY_PLATFORM)
      no_arguments(arguments)
      runner = runner_class.new(owner_root: ROOT, log_dir: File.join(ROOT, 'build/logs'))
      tests = SanitizerTests.discover(root: ROOT).map { |test| File.join(ROOT, test) }
      left_out = []
      runtime.call(runner: runner) do |environment|
        left_out = run_tests(tests, runner: runner, name: 'sanitizer-tests', platform: platform,
                             environment: environment.merge('ERX_SANITIZERS' => 'address,undefined'))
      end
      passed = tests - left_out.map(&:path)
      Terminal.puts('these tests passed with ERX_SANITIZERS=address,undefined: ' \
                    "#{passed.map { |test| File.basename(test, '_test.rb') }.join(' ')}#{not_run_note(left_out)}")
      if RbConfig::CONFIG.fetch('host_os').include?('darwin')
        Terminal.puts('LeakSanitizer and ASan initialization-order checks: unsupported on macOS; Linux run required')
      end
      0
    end

    # What the discovered gates run, one line each, for a reader or a diff.
    def self.gates(arguments)
      no_arguments(arguments)
      require_relative 'fuzz/run_pack'
      SanitizerTests.discover(root: ROOT).each { |test| Terminal.puts("sanitizer test: #{test}") }
      serial = Dir.glob('test/{host,integration}/*_test.rb', base: ROOT).sort
                  .select { |test| TestPool.serial?(File.join(ROOT, test)) }
      Terminal.puts("test pool: #{TestPool.jobs} parallel processes (#{TestPool::JOBS_VARIABLE} overrides); " \
                    "each file under its own #{TEST_FILE_DEADLINE}s deadline; " \
                    "serial files: #{serial.empty? ? 'none' : serial.join(' ')}")
      QemuGate.suites.each { |suite| Terminal.puts("QEMU suite: #{suite.name}") }
      FuzzDrivers.runs(root: ROOT, **FUZZ_DEFAULTS.slice(:seconds, :seed)).each do |run|
        Terminal.puts("Ruby fuzz driver: #{run.name}: #{run.path} #{run.arguments.join(' ')}, deadline #{run.deadline}s")
      end
      PackFuzz.targets.each do |target|
        Terminal.puts("native fuzz target: #{target.kind}: #{target.seeds.size} seeds; " \
                      "sources #{target.sources.join(' ')}; includes #{target.includes.join(' ')}")
      end
      ChokepointRules::ALL.sort_by(&:name).each do |rule|
        seeds = rule.respond_to?(:seed) ? rule.seed.size : 0
        Terminal.puts("chokepoint rule: #{rule.name}: #{rule.class.name.split('::').last}, #{seeds} seeds")
      end
      0
    end

    # check-fuzz's budget per timed Ruby driver, executions per C target, and seed.
    FUZZ_DEFAULTS = { seconds: 3, runs: 20_000, seed: 1 }.freeze

    def self.check_fuzz(input_arguments, runner_class: Runner, runtime: method(:with_test_runtime),
                        c_fuzzer: method(:fuzz_c), ruby_fuzzer: method(:fuzz_ruby))
      arguments = input_arguments.dup
      options = FUZZ_DEFAULTS.dup
      OptionParser.new do |flags|
        flags.on('--seconds N', Integer, 'Budget per timed Ruby target, 1..60') { |value| options[:seconds] = value }
        flags.on('--runs N', Integer, 'C libFuzzer executions per target, 1..10000000') { |value| options[:runs] = value }
        flags.on('--seed N', Integer, 'Seed for C ABI targets and Ruby drivers') { |value| options[:seed] = value }
      end.parse!(arguments)
      unless arguments.empty? && options.fetch(:seconds).between?(1, 60) &&
             options.fetch(:runs).between?(1, 10_000_000) && options.fetch(:seed).between?(0, (1 << 31) - 1)
        raise OptionParser::InvalidArgument, 'fuzz budget, seed or trailing arguments outside bounds'
      end
      plan = FuzzDrivers.runs(root: ROOT, seconds: options.fetch(:seconds), seed: options.fetch(:seed))
      runner = runner_class.new(owner_root: ROOT, log_dir: File.join(ROOT, 'build/logs'))
      runtime.call(runner: runner) do |environment|
        c_fuzzer.call(runner: runner, environment: environment, runs: options.fetch(:runs), seed: options.fetch(:seed))
        ruby_fuzzer.call(runner: runner, environment: environment, plan: plan)
        runner.run([RbConfig.ruby, File.join(ROOT, 'test/host/abi_erlang_test.rb'),
                    '--name', 'test_production_fuzz_entry_refuses_mutations_without_vm_exception'],
                   name: 'fuzz-erlang-manifest', deadline: 180, chdir: ROOT, env: environment)
        runner.run([RbConfig.ruby, File.join(ROOT, 'test/host/erx_tcp_explore_test.rb')],
                   name: 'explore-erx-tcp', deadline: 900, chdir: ROOT,
                   env: environment.merge('ERX_TCP_EXPLORE' => 'full'))
        runner.run([RbConfig.ruby, File.join(ROOT, 'test/host/erx_hostlink_session_test.rb')],
                   name: 'explore-erx-hostlink-session', deadline: 900, chdir: ROOT,
                   env: environment.merge('ERX_EXPLORE_DEPTH' => 'full'))
        runner.run([RbConfig.ruby, File.join(ROOT, 'test/host/erx_pipe_test.rb')],
                   name: 'explore-erx-pipe', deadline: 900, chdir: ROOT,
                   env: environment.merge('ERX_PIPE_EXPLORE_DEPTH' => 'full'))
        runner.run([RbConfig.ruby, File.join(ROOT, 'test/host/pipe_core_test.rb'),
                    '-n', 'test_every_interleaving_keeps_the_invariants'],
                   name: 'explore-pipe-core', deadline: 3600, chdir: ROOT,
                   env: environment.merge('ERX_PIPE_EXPLORE' => 'full'))
      end
      require_relative 'fuzz/run_pack'
      Terminal.puts('ABI and Erlang manifest fuzz targets and full explorations passed')
      Terminal.puts("native fuzz targets passed: #{PackFuzz.targets.map(&:kind).join(' ')}")
      Terminal.puts("Ruby fuzz drivers passed: #{plan.map(&:name).join(' ')}")
      Terminal.puts('fixed Ruby drivers ran their own iteration counts and seeds; native C seeds are recorded in logs')
      Terminal.puts('root-startup and target runtime/service parsers: unsupported until their implementations land')
      0
    end

    def self.fuzz_c(runner:, environment:, runs:, seed:)
      require_relative 'fuzz/run_pack'
      FuzzWorkspace.run(root: ROOT, name: 'abi', maximum_input: 65_536) do |directory, artifacts|
        corpus = File.join(directory, 'corpus')
        Dir.mkdir(corpus, 0o700)
        program = File.join(directory, 'abi-fuzz')
        runner.run([RbConfig.ruby, File.join(ROOT, 'test/fuzz/abi_corpus.rb'), corpus],
                   name: 'abi-fuzz-corpus', deadline: 30, chdir: ROOT, env: environment)
        runner.run([environment.fetch('ERX_CLANG'), '-std=c17', '-Wall', '-Wextra', '-Werror', '-pedantic',
                    '-O1', '-g', '-fsanitize=fuzzer,address,undefined', '-fno-omit-frame-pointer',
                    *Generated.include_flags(root: ROOT), '-I', File.join(ROOT, 'include'), '-I', ROOT,
                    Generated.path('liberx/generated/abi_reader.c', root: ROOT),
                    Generated.path('kernel/generated/abi_decode.c', root: ROOT),
                    Generated.path('fuzz/generated/abi.c', root: ROOT), '-o', program],
                   name: 'compile-abi-fuzz', deadline: 90, chdir: ROOT, env: environment)
        runner.run([program, "-runs=#{runs}", "-seed=#{seed}", '-max_len=65536', '-timeout=5',
                    "-artifact_prefix=#{artifacts}/", corpus],
                   name: 'abi-fuzz', deadline: 180, chdir: ROOT, env: environment)
      end
      runner.run([RbConfig.ruby, File.join(ROOT, 'tools/fuzz/run_pack.rb')],
                 name: 'pack-elf-fuzz', deadline: PackFuzz.deadline, chdir: ROOT,
                 env: environment.merge('RUNS' => runs.to_s))
    end

    # Runs each driver of FuzzDrivers' plan, checked whole before check-fuzz started anything.
    def self.fuzz_ruby(runner:, environment:, plan:)
      plan.each do |run|
        runner.run([RbConfig.ruby, File.join(ROOT, run.path), *run.arguments],
                   name: run.name, deadline: run.deadline, chdir: ROOT, env: environment)
      end
    end

    # Builds Fiasco and packs the production image into build/production-image/PLATFORM
    # (ProductionImage.pack_platform), QEMU virt's by default or with --platform NAME
    # that board's; with --medium, also the development medium that holds it: the release
    # medium for QEMU (ReleaseMedium), or a board's boot partition and SD card image
    # (BootPartition). With --published, instead the medium the website offers, QEMU's or
    # the board's card (ProductionImage::MediumKind.published): it carries the kiosk alone
    # and the Doom example as /bin/doom, so it needs `tools/erx fetch --example doom`
    # first, and takes no app, signer or --local of its builder's. Every image is packed for
    # ProductionImage::Machine.development. With --probe header, instead the Raspberry Pi
    # 4's header probe card (HeaderProbe), a card of its own that needs no Fiasco and no
    # image; it is a medium already, so it takes neither. Each --app adds an app to the
    # image (image_apps, docs/design-packaging.md, "Adding an app to an image"), into its
    # medium's system partition, so --app implies --medium (pack_options); --enable NAME
    # starts it at boot and --signer FILE trusts a deployer's key for packages installed
    # later. --local makes it a local test image, which takes a package whose license is
    # not permissive and never leaves this host (ImageApps::Plan). A board's card is the
    # website's whatever its kind and takes no app, signer or --local either
    # (ProductionImage.check_medium).
    def self.pack(arguments)
      pack_options(arguments) => { platform:, medium:, probe:, sources:, enable:, signers:, local: }
      runner = Runner.new(owner_root: ROOT, log_dir: File.join(ROOT, 'build/logs'))
      environment = host_environment(runner: runner)
      return pack_probe(runner: runner, environment: environment, platform: platform) if probe
      apps = image_apps(runner: runner, sources: sources, enable: enable, signers: signers, local: local,
                        compiler: environment.fetch('ERX_CLANG'), linker: environment.fetch('ERX_LLD'))
      result = ProductionImage.pack_platform(root: ROOT, runner: runner, compiler: environment.fetch('ERX_CLANG'),
                                             linker: environment.fetch('ERX_LLD'), platform: platform, medium: medium,
                                             apps: apps)
      built, written = medium ? result : [result, nil]
      Terminal.puts("production image: #{built.single}")
      case written
      in nil
        nil
      in BootPartition::Written
        Terminal.puts("boot partition: #{written.files}; SD card image: #{written.path}; compressed: #{written.compressed}; " \
                      "build record: #{written.record}")
      in ReleaseMedium::Written
        extents = written.slot.images.map do |extent|
          "#{extent.file.name} at slot byte #{extent.slot_offset}, #{extent.file.length} bytes"
        end
        Terminal.puts("release medium: #{written.path}; EROFS image: #{written.erofs}; #{extents.join('; ')}")
      end
      0
    end

    # pack's options, parsed from arguments and checked whole before anything is built.
    PackOptions = Data.define(:platform, :medium, :probe, :sources, :enable, :signers, :local)

    # The PackOptions of pack's arguments, parsed and checked. medium is the medium's
    # stated kind (ProductionImage::MediumKind), or nil for the image alone: --published
    # gives the published kind, and otherwise --medium the development kind, as an --app
    # does, since an image's packages lie in its medium's system partition. The published
    # medium takes no app, signer or --local of its builder's, and --probe takes no medium.
    def self.pack_options(arguments)
      require_relative 'lib/erx/production_image'
      medium = false
      published = false
      local = false
      probe = nil
      sources = []
      enable = []
      signers = []
      platform = platform_option(arguments) do |flags|
        flags.on('--medium') { medium = true }
        flags.on('--published') { published = true }
        flags.on('--probe NAME', %w[header]) { |name| probe = name }
        flags.on('--app PATH') { |path| sources << File.expand_path(path) }
        flags.on('--enable NAME') { |name| enable << name }
        flags.on('--signer FILE') { |path| signers << File.expand_path(path) }
        flags.on('--local') { local = true }
      end
      no_arguments(arguments)
      builders = local || !(sources + enable + signers).empty?
      raise Error, 'pack: --probe packs a card of its own and takes no --medium or --published' if probe && (medium || published)
      raise Error, 'pack: --probe packs a card of its own and takes no app' if probe && builders
      if published && builders
        raise Error, 'pack: --published packs the medium the website offers, which takes no app, signer or --local'
      end

      kind = if published
               ProductionImage::MediumKind.published
             elsif medium || !sources.empty?
               ProductionImage::MediumKind.development
             end
      PackOptions.new(platform: platform, medium: kind, probe: probe, sources: sources.freeze,
                      enable: enable.freeze, signers: signers.freeze, local: local)
    end

    # The packages pack's --app options add to the image, as an ImageApps::Plan: each app
    # directory packed with the SDK exported into build/app-sdk and the host's development
    # package key (Erx::PackageKey), or each package file as given, both staged in
    # build/app-packages, which the image takes them from; each directory is cleared
    # first. The key's private half stays in its directory.
    def self.image_apps(runner:, sources:, enable:, signers:, local:, compiler:, linker:)
      require_relative 'lib/erx/image_apps'
      return ImageApps.none unless local || !(sources + enable + signers).empty?

      require_relative 'lib/erx/package_key'
      require_relative 'lib/erx/sdk'
      key = PackageKey.ensure
      packages = sources.empty? ? [] : gathered_apps(sources, runner: runner, signer: key, compiler: compiler, linker: linker)
      ImageApps.plan(packages, enable: enable, signers: signers.map { |path| ImageApps.signer(path) }, local: local)
    end

    # The packages of sources (ImageApps.gather), packed with an SDK exported into
    # build/app-sdk and signed by signer, staged in build/app-packages.
    def self.gathered_apps(sources, runner:, signer:, compiler:, linker:)
      ImageApps.packed_apps(sources, sdk_directory: empty_build_directory('build/app-sdk'),
                                     packages_directory: empty_build_directory('build/app-packages'),
                                     root: ROOT, runner: runner, signer: signer, compiler: compiler, linker: linker)
    end

    # The directory relative names under the tree, made empty.
    def self.empty_build_directory(relative)
      directory = ProductionImage.clear_directory(root: ROOT, path: File.join(ROOT, relative))
      FileUtils.mkdir_p(directory)
      directory
    end

