    # OpenSSL's libcrypto.a for erxos-aarch64, into build/openssl/obj, against a musl of
    # its own build (Libcrypto).
    def self.build_openssl(jobs)
      require_relative 'lib/erx/libcrypto'
      runner = Runner.new(owner_root: ROOT, log_dir: File.join(ROOT, 'build/logs'))
      compiler = host_environment(runner: runner).fetch('ERX_CLANG')
      headers = Libcrypto.headers(root: ROOT, runner: runner, compiler: compiler, jobs: jobs)
      Libcrypto.new(root: ROOT, runner: runner, compiler: compiler)
             .build(directory: File.join(ROOT, Libcrypto::BASE, 'obj'), headers: headers, jobs: jobs)
    end

    # The hosted runtime and the release it boots, both of which `make check-runtime-hosted` reads.
    def self.build_runtime(jobs)
      built = Runtime.new(root: ROOT).build(jobs: jobs)
      Release.new(root: ROOT, output: built, platform: Platform.development(ROOT)).build
      built.archive
    end

    # The BeamAsm image, linked as the production image links it for its domains, into
    # build/runtime/native-jit/image; Fiasco's build must have run.
    def self.build_jit_runtime(jobs)
      require_relative 'lib/erx/native_jit_runtime'

      runner = Runner.new(owner_root: ROOT, log_dir: File.join(ROOT, 'build/logs'))
      compiler = ENV.fetch('ERX_CLANG', '')
      linker = ENV.fetch('ERX_LLD', '')
      fiasco = Fiasco.new(root: ROOT, runner: runner, compiler: compiler)
      platform = Platform.development(ROOT)
      interpreter = NativeRuntime.new(root: ROOT, runner: runner, compiler: compiler, linker: linker, fiasco: fiasco,
                                    platform: platform).build(jobs: jobs)
      jit = NativeJitRuntime.new(root: ROOT, runner: runner, compiler: compiler, linker: linker, fiasco: fiasco,
                                 platform: platform)
                            .build(interpreter: interpreter, jobs: jobs)
      native = NativeRoot.new(root: ROOT, runner: runner, compiler: compiler, linker: linker, platform: platform, fiasco: fiasco)
      # The link writes its image under build/runtime, so it holds the tree's lock as a build does.
      Runtime.hold_tree(ROOT, mode: :exclusive) do
        native.build_jit_runtime_receipted(directory: File.join(ROOT, NativeJitRuntime::BASE, 'image'),
                                           archives: jit.domain_archives)
              .fetch(:program)
      end
    end

    def self.build(input_arguments)
      arguments = input_arguments.dup
      component = arguments.shift
      unless %w[fiasco release-kernel runtime jit-runtime rc-oracle glyphs fsimg herd7 lvgl openssl web l4re].include?(component)
        raise OptionParser::InvalidArgument,
              'build accepts fiasco, release-kernel, runtime, jit-runtime, rc-oracle, glyphs, fsimg, herd7, lvgl, openssl, web or l4re'
      end
      jobs = 4
      docker_context = nil
      l4re_platform = nil
      parser = OptionParser.new do |options|
        options.on('--jobs N', Integer, 'Parallel inherited build jobs') { |value| jobs = value }
        options.on('--docker-context NAME', "Docker context of L4Re's container build (build l4re only)") { |value| docker_context = value }
        options.on('--platform NAME', %w[virt raspi4b], "L4Re's guest's board: virt, the default, or raspi4b (build l4re only)") { |value| l4re_platform = value }
      end
      parser.parse!(arguments)
      raise OptionParser::InvalidArgument, 'unexpected arguments' unless arguments.empty?
      raise OptionParser::InvalidArgument, 'build l4re needs --docker-context NAME' if (component == 'l4re') != !docker_context.nil?
      raise OptionParser::InvalidArgument, '--platform applies only to build l4re' if l4re_platform && component != 'l4re'
      path = case component
             when 'runtime' then build_runtime(jobs)
             when 'jit-runtime' then build_jit_runtime(jobs)
             when 'rc-oracle' then build_rc_oracle
             when 'glyphs' then build_glyphs
             when 'fsimg' then build_fsimg(jobs)
             when 'herd7' then build_herd7(jobs)
             when 'lvgl' then build_lvgl(jobs)
             when 'openssl' then build_openssl(jobs)
             when 'release-kernel' then Fiasco.new(root: ROOT).build_release_kernel(jobs: jobs)
             when 'web' then WebBuild.build(root: ROOT, runner: Runner.new(owner_root: ROOT, log_dir: File.join(ROOT, 'build/logs')))
             when 'l4re' then build_l4re(jobs, docker_context, l4re_platform || 'virt')
             else Fiasco.new(root: ROOT).build(jobs: jobs)
             end
      Terminal.puts("built #{path}")
      0
    end

    # L4Re's guest (L4ReBuild): built in the oracle's arm64 image on the Docker context for
    # platform, leaving its bootable file and build record in build/l4re (QEMU virt) or
    # build/l4re-raspi4b (the Raspberry Pi 4).
    def self.build_l4re(jobs, context, platform)
      require_relative 'lib/erx/l4re_build'
      L4ReBuild.build(root: ROOT, runner: Runner.new(owner_root: ROOT, log_dir: File.join(ROOT, 'build/logs')),
                      context: context, jobs: jobs, target: L4ReBuild::TARGETS.fetch(platform))
    end

    # The development boot image in QEMU with its serial line on this terminal,
    # for a person to type at (InteractiveBoot); with --hostlink, also its host
    # link on a socket and a data medium, and the `tools/erx web` line to run
    # next; with --without-web, the website's image, from its own manifest, which has
    # no web domain; with --medium, a release medium as it is, built by none of these
    # (boot_medium).
    # The arguments are read whole before anything is built or run.
    def self.boot(arguments, runner_class: Runner)
      request = InteractiveBoot.request(arguments)
      runner = runner_class.new(owner_root: ROOT, log_dir: File.join(ROOT, 'build/logs'))
      platform = Platform.development(ROOT)
      accel = request.accel || InteractiveBoot.default_accel(QemuGate.available_accelerators(runner: runner))
      return boot_medium(request, platform: platform, accel: accel, runner: runner) if request.medium

      kind = request.without_web ? 'website' : 'development'
      Terminal.puts("building the #{kind} boot image into #{InteractiveBoot.image_directory(without_web: request.without_web)}")
      boot = InteractiveBoot.build(root: ROOT, runner: runner, jobs: request.jobs, hostlink: request.hostlink,
                                    platform: platform, without_web: request.without_web)
      memory_mib = InteractiveBoot.machine(platform: platform, without_web: request.without_web).memory_mib
      argv = InteractiveBoot.argv(platform: platform, accel: accel, cpus: request.cpus, image: boot.image,
                                  memory_mib: memory_mib, link: boot.link)
      Terminal.puts("booting: accelerator #{accel}, #{request.cpus} guest CPU(s); #{InteractiveBoot::QUIT_HINT}")
      if boot.link
        Terminal.puts("host link on #{boot.link.socket}; once root's session has started, run in another terminal:")
        Terminal.puts("  #{InteractiveBoot.web_command(File.join(ROOT, 'tools/erx'), boot.link.socket)}")
      end
      InteractiveBoot.run(argv)
    end

    # `tools/erx boot --medium PATH`: the release medium at PATH in QEMU as a person boots
    # it (InteractiveBoot.medium_argv), on the machine of the board's manifest
    # (ProductionImage::Machine.development), which every medium
    # `tools/erx pack --medium` or `--published` writes is packed for; with --print, the plain
    # qemu-system-aarch64 command instead, whose
    # kernel, device tree and disk lie in the tree until the next --medium. The guest
    # boots a copy of the medium (InteractiveBoot.medium_copy), where it keeps its /data
    # and SSH host key from boot to boot, so the medium at PATH stays as written.
    def self.boot_medium(request, platform:, accel:, runner:)
      machine = ProductionImage::Machine.development(platform)
      files = InteractiveBoot.medium_boot(root: ROOT, runner: runner, medium: request.medium, machine: machine,
                                          cpus: request.cpus)
      argv = InteractiveBoot.medium_argv(platform: platform, accel: accel, cpus: request.cpus, kernel: files.kernel,
                                         medium: files.disk, memory_mib: machine.memory_mib, dtb: files.dtb)
      if request.print
        puts Shellwords.join(argv)
        return 0
      end

      Terminal.puts("booting #{request.medium} from #{files.fresh ? 'a new' : 'its'} copy #{files.disk}: accelerator " \
                    "#{accel}, #{request.cpus} guest CPU(s); " \
                    "ssh -p #{InteractiveBoot::MEDIUM_SSH_PORT} root@127.0.0.1; #{InteractiveBoot::QUIT_HINT}")
      InteractiveBoot.run(argv)
    end

    # The host's ssh as root into a development guest whose daemon root's session
    # started at boot (erx_ssh_dev:boot/1), through a host loopback port forwarded to it,
    # --port (by default DevKey::PORT), with the clone's development login key (DevKey)
    # and the interactive boot's known-hosts file, which each boot's build starts afresh
    # in its directory. Without arguments the guest's daemon gives root rc on a tty;
    # arguments, joined by spaces as ssh joins them, are a command it runs with rc -c as
    # a job with no tty, its output and error output apart (docs/design-ssh.md,
    # "Stages"). ssh replaces this process, so the terminal is the guest's, and a
    # job's output and error output are this process's. `tools/erx boot` forwards no
    # port to the guest (docs/todo-session.md, "SSH from tools/erx boot").
    def self.ssh(input_arguments)
      arguments = input_arguments.dup
      port = DevKey::PORT
      OptionParser.new { |flags| flags.on('--port N', Integer, 'Host loopback port of the guest forward') { |value| port = value } }
                  .order!(arguments)
      command = arguments.empty? ? nil : arguments.join(' ')

      runner = Runner.new(owner_root: ROOT, log_dir: File.join(ROOT, 'build/logs'))
      directory = DevKey.directory(root: ROOT, runner: runner)
      raise Error, "no development login key at #{directory}; run tools/erx setup" unless File.exist?(directory)

      known_hosts = File.join(ROOT, InteractiveBoot::DIRECTORY, DevKey::KNOWN_HOSTS)
      exec(*DevKey.ssh_argv(pair: DevKey.read(directory: directory, runner: runner), port: port, known_hosts: known_hosts,
                            command: command))
    end

    # One boot of the built kernel image, its serial output in a log: under HVF
    # when this host's QEMU offers it, as `boot` chooses, unless --accel names one.
    def self.qemu(input_arguments)
      arguments = input_arguments.dup
      options = { image: Fiasco.new(root: ROOT).image_path }
      parser = OptionParser.new do |flags|
        flags.on('--accel NAME', %w[tcg hvf], 'Guest accelerator') { |value| options[:accel] = value }
        flags.on('--image PATH', 'Explicit built guest image') { |value| options[:image] = value }
        flags.on('--cpus N', Integer, 'Guest CPUs') { |value| options[:cpus] = value }
        flags.on('--memory-mib N', Integer, 'Guest RAM in MiB') { |value| options[:memory_mib] = value }
      end
      parser.parse!(arguments)
      raise OptionParser::InvalidArgument, 'unexpected arguments' unless arguments.empty?
      options[:accel] ||= InteractiveBoot.default_accel(
        QemuGate.available_accelerators(runner: Runner.new(owner_root: ROOT, log_dir: File.join(ROOT, 'build/logs')))
      )
      report = Qemu.new(root: ROOT).run(platform: Platform.development(ROOT), **options)
      Terminal.puts("#{options.fetch(:accel)}: #{report.fetch('state')}; #{report.fetch('serial_log')}")
      0
    end

    # Everything a fresh worktree needs before its gates run, or with
    # --bootstrap the steps `make oracle-bootstrap` runs (Setup::BOOTSTRAP);
    # steps whose output is already valid are skipped. Takes no network path:
    # sources come from `make fetch` or from ERX_SOURCE_CACHE, verified by hash.
    def self.setup(input_arguments, setup_class: Setup)
      arguments = input_arguments.dup
      jobs = 4
      only = nil
      parser = OptionParser.new do |options|
        options.on('--jobs N', Integer, 'Parallel inherited build jobs') { |value| jobs = value }
        options.on('--bootstrap', 'Only the oracles and fsimg') { only = Setup::BOOTSTRAP }
      end
      parser.parse!(arguments)
      raise OptionParser::InvalidArgument, 'unexpected arguments' unless arguments.empty?

      ran = setup_class.new(root: ROOT, jobs: jobs, only: only).call
      Terminal.puts(ran.empty? ? 'setup: nothing to do' : "setup: ran #{ran.join(', ')}")
      0
    end

    # Every pinned source, LVGL and every package set; with --cache, every
    # source the cache holds and nothing else. Given --source ID or --packages
    # NAME (each repeatable), only the sources and package sets named. A
    # package set (package_sets) comes from the npm registry by its lockfile
    # (WebBuild.fetch), which a source cache does not hold.
    def self.fetch(input_arguments, package_fetch: WebBuild.method(:fetch), dependencies_class: Dependencies)
      arguments = input_arguments.dup
      cache = nil
      source_ids = []
      package_names = []
      docker_context = nil
      example = nil
      side = nil
      sets = package_sets
      parser = OptionParser.new do |options|
        options.on('--cache DIRECTORY', "Use only another checkout's build/downloads (with --l4re or --linux, its build/l4re-sources/build/downloads or build/linux-sources/build/downloads) as the source cache") { |value| cache = value }
        options.on('--source ID', 'Fetch this pinned source; repeatable') { |value| source_ids << value }
        options.on('--packages NAME', "Install this package set (#{sets.keys.join(', ')}); repeatable") { |value| package_names << value }
        options.on('--docker-context NAME', 'Use this local Docker context for image fetch') { |value| docker_context = value }
        options.on('--example NAME', 'Fetch only this example and its downloads (doom), which no other fetch obtains') { |value| example = value }
        options.on('--l4re', "Fetch only L4Re's guest's sources (bench/l4re/deps.lock), which no other fetch obtains") { side = side ? :both : L4ReFetch }
        options.on('--linux', "Fetch only Linux's guest's sources (bench/linux/deps.lock), which no other fetch obtains") { side = side ? :both : LinuxGuest }
      end
      parser.parse!(arguments)
      raise OptionParser::InvalidArgument, 'unexpected arguments' unless arguments.empty?
      unknown = package_names - sets.keys
      raise OptionParser::InvalidArgument, "no package set #{unknown.join(', ')}; the sets are #{sets.keys.join(', ')}" unless
        unknown.empty?
      if (example || side) && !(source_ids.empty? && package_names.empty? && docker_context.nil?)
        raise OptionParser::InvalidArgument, '--example, --l4re and --linux take no --source, --packages or --docker-context'
      end
      raise OptionParser::InvalidArgument, '--example, --l4re and --linux are separate fetches' if (example && side) || side == :both

      runner = Runner.new(owner_root: ROOT, log_dir: File.join(ROOT, 'build/logs'))
      return fetch_example(example, cache: cache, runner: runner) if example
      return fetch_side(side, cache: cache, runner: runner) if side

      everything = source_ids.empty? && package_names.empty?
      if everything || !source_ids.empty?
        fetch_sources(everything ? nil : source_ids, cache:,
                      dependencies: dependencies_class.new(root: ROOT, runner: runner, docker_context: docker_context))
      elsif cache || docker_context
        raise OptionParser::InvalidArgument, '--cache and --docker-context fetch sources, and --packages names none'
      end
      # LVGL is a git submodule, cloned from its recorded URL at its recorded
      # commit; a cache holds only deps.lock's archives, so a fetch from one
      # leaves the submodule to `tools/erx setup`.
      require_relative 'lib/erx/lvgl'
      complete = everything && cache.nil?
      Terminal.puts(complete ? Lvgl.init(root: ROOT, runner: runner) : "LVGL: not fetched; run `#{Lvgl::INIT_COMMAND}`")
      installing = complete ? sets.keys : package_names
      sets.each_value do |packages|
        status = if installing.include?(packages.name)
                   package_fetch.call(root: ROOT, runner: runner, packages: packages)
                 else
                   "not fetched; run `tools/erx fetch --packages #{packages.name}`"
                 end
        Terminal.puts("#{packages.title}'s packages: #{status}")
      end
      0
    end

    # The package sets `tools/erx fetch` installs, by name: the web client's,
    # the book site's diagram step's and the website console's.
    def self.package_sets
      require_relative 'lib/erx/book_diagrams'
      require_relative 'lib/erx/site'
      [WebBuild::WEB, Book::Diagrams::PACKAGES, Site::PACKAGES].to_h { |packages| [packages.name, packages] }
    end

    # The pinned sources source_ids names, or every one when it is nil (Dependencies#fetch).
    def self.fetch_sources(source_ids, cache:, dependencies:)
      # A source cache holds no OCI image; say so before fetch, which may stop at a source the cache lacks.
      if cache && source_ids.nil?
        dependencies.images.each do |image|
          Terminal.puts("#{image.fetch('id')}: an OCI image, not in a source cache; run `tools/erx fetch --source #{image.fetch('id')}`")
        end
      end
      dependencies.fetch(cache: cache, source_ids: source_ids)
      dependencies.elsewhere.each do |source|
        Terminal.puts("#{source.fetch('id')}: a program for #{source.fetch('host')}; not fetched on this host")
      end
      Terminal.puts('sources verified and extracted')
    end

    # An example is a git submodule a clone does not check out, and the downloads its
    # own deps.lock pins (ExampleFetch); the fetch above never obtains either.
    def self.fetch_example(name, cache:, runner:)
      require_relative 'lib/erx/example_fetch'
      ExampleFetch.fetch(name: name, root: ROOT, runner: runner, cache: cache).each { |line| Terminal.puts(line) }
      0
    end

    # A comparison guest's sources are pinned in its own lock (SideLock: L4ReFetch,
    # LinuxGuest); the fetch above never obtains them.
    def self.fetch_side(side, cache:, runner:)
      side.fetch(root: ROOT, runner: runner, cache: cache).each { |line| Terminal.puts(line) }
      0
    end

    def self.oracle(input_arguments, native_class: Oracle, container_class: OracleContainer,
                    hosted_class: OracleHosted, qemu_class: OracleQemu)
      arguments = input_arguments.dup
      action = arguments.shift
      return oracle_hosted(arguments, hosted_class: hosted_class) if action == 'hosted'
      return oracle_qemu(arguments, qemu_class: qemu_class) if action == 'qemu'
      unless %w[build run probe install].include?(action)
        raise OptionParser::InvalidArgument, 'usage: oracle build|run SUITE|probe|install [--docker-context NAME] [--flavour emu|jit] | ' \
                                           'oracle hosted [--out DIR] [--deadline SECONDS] [--suites LIST] | ' \
                                           'oracle qemu [--out DIR] [--deadline SECONDS] [--accel tcg|hvf] [--cpus N] [--suites LIST]'
      end
      suite = arguments.shift if action == 'run'
      options = { backend: 'linux', flavour: 'emu', jobs: 4, deadline: 14_400, clean: false }
      OptionParser.new do |flags|
        flags.on('--backend NAME', %w[linux native], 'Linux suites or native bootstrap build') { |value| options[:backend] = value }
        flags.on('--docker-context NAME', 'Explicit local Docker context; cached pinned image only') { |value| options[:context] = value }
        flags.on('--flavour NAME', %w[emu jit]) { |value| options[:flavour] = value }
        flags.on('--jobs N', Integer) { |value| options[:jobs] = value } unless action == 'probe'
        if action == 'run'
          flags.on('--deadline SECONDS', Integer, 'Suite hard deadline') { |value| options[:deadline] = value }
          flags.on('--suite NAME', 'Select one stock Common Test suite') { |value| options[:test_suite] = value }
          flags.on('--case NAME', 'Select a case within --suite') { |value| options[:testcase] = value }
        end
        if action == 'build'
          flags.on('--clean', 'Replace an existing native bootstrap build') { options[:clean] = true }
        end
      end.parse!(arguments)
      raise OptionParser::InvalidArgument, 'unexpected arguments' unless arguments.empty?
      unless options.fetch(:jobs).between?(1, 64)
        raise OptionParser::InvalidArgument, 'jobs must be between 1 and 64'
      end
      if options.fetch(:backend) == 'native'
        unless action == 'build' && !options[:context]
          raise OptionParser::InvalidArgument, 'native backend supports bootstrap build only, without Docker context'
        end
        native_class.new(root: ROOT).build(flavours: [options.fetch(:flavour)], jobs: options.fetch(:jobs), clean: options.fetch(:clean))
        Terminal.puts("native stock OTP bootstrap #{options.fetch(:flavour)} ready")
        return 0
      end
      raise OptionParser::InvalidArgument, '--clean applies to native bootstrap builds' if options.fetch(:clean)
      backend = container_class.new(root: ROOT, context: options[:context])
      result = case action
               when 'build'
                 backend.build(flavours: [options.fetch(:flavour)], jobs: options.fetch(:jobs)).first
               when 'probe'
                 backend.probe(flavour: options.fetch(:flavour))
               when 'install'
                 backend.install(flavour: options.fetch(:flavour), jobs: options.fetch(:jobs))
               when 'run'
                 backend.run(suite, flavour: options.fetch(:flavour), jobs: options.fetch(:jobs),
                             deadline: options.fetch(:deadline), test_suite: options[:test_suite], testcase: options[:testcase])
               end
      Terminal.puts("Linux host oracle: #{result.fetch('state')}; #{result.fetch('report')}")
      result.fetch('state') == 'completed' || result.fetch('state') == 'ready' ? 0 : 1
    end

    # OTP's suite groups under Common Test on the hosted runtime and on stock
    # OTP, compared case by case against each group's table of known
    # differences. `--suites` names groups, `group/SUITE`s or `fast`, and
    # defaults to `fast`; the exit is 0 only when every group's comparison
    # passes.
    def self.oracle_hosted(arguments, hosted_class:)
      options = { out: File.join(ROOT, 'build/oracle-hosted'), deadline: 1800, suites: ['fast'] }
      OptionParser.new do |flags|
        flags.on('--out DIR', 'Directory for the trees, event streams, logs and reports') { |value| options[:out] = value }
        flags.on('--deadline SECONDS', Integer, 'Hard deadline of each run') { |value| options[:deadline] = value }
        suites_option(flags, options)
      end.parse!(arguments)
      selection = oracle_selection(arguments, options)
      oracle_groups(selection, out: options[:out]) do |group, suites, out|
        hosted_class.new(root: ROOT, out: out, deadline: options[:deadline], group: group).run(suites).result
      end
    end

    # The same suites in the system domain under QEMU, compared with stock OTP
    # against the same tables. The exit is 0 only when every group's
    # comparison passes.
    def self.oracle_qemu(arguments, qemu_class:)
      options = { out: File.join(ROOT, 'build/oracle-qemu'), deadline: 1800, accel: QemuGate::SUITE_ACCELERATOR, cpus: 1, jobs: 4,
                  suites: ['fast'] }
      OptionParser.new do |flags|
        flags.on('--out DIR', 'Directory for the trees, images, serial logs, event streams and reports') { |value| options[:out] = value }
        flags.on('--deadline SECONDS', Integer, 'Hard deadline of each run') { |value| options[:deadline] = value }
        flags.on('--accel NAME', %w[tcg hvf], 'Accelerator') { |value| options[:accel] = value }
        flags.on('--cpus N', Integer, 'Guest CPUs') { |value| options[:cpus] = value }
        flags.on('--jobs N', Integer, 'Build jobs') { |value| options[:jobs] = value }
        suites_option(flags, options)
      end.parse!(arguments)
      selection = oracle_selection(arguments, options)
      oracle_groups(selection, out: options[:out]) do |group, suites, out|
        outcome = qemu_class.new(root: ROOT, out: out, deadline: options[:deadline], group: group)
                            .run(suites, accel: options[:accel], cpus: options[:cpus], jobs: options[:jobs])
        Terminal.puts("#{group}: guest #{options[:accel]} #{options[:cpus]} CPU, #{outcome.seconds ? "#{outcome.seconds.round} s" : 'unknown'}")
        outcome.result
      end
    end

    def self.suites_option(flags, options)
      flags.on('--suites LIST', Array, 'Groups, group/SUITEs or fast, comma-separated') { |value| options[:suites] = value }
    end

    # The groups and suites `options[:suites]` names, once the options are
    # checked and no argument is left over.
    def self.oracle_selection(arguments, options)
      raise OptionParser::InvalidArgument, "unexpected arguments: #{arguments.join(' ')}" unless arguments.empty?
      raise OptionParser::InvalidArgument, 'deadline must be between 60 and 86400 seconds' unless options[:deadline].between?(60, 86_400)

      OracleSuites.select(options[:suites], root: ROOT)
    rescue Error => error
      raise OptionParser::InvalidArgument, error.message
    end

    # Runs each group of `selection` in turn, in `out/<group>`, through the
    # block, which returns the group's comparison; then prints and writes the
    # combined report. The exit is 0 only when every group passed.
    def self.oracle_groups(selection, out:)
      results = selection.to_h { |group, suites| [group, yield(group, suites, File.join(out, group))] }
      report = File.join(FileUtils.mkdir_p(out).first, 'report.txt')
      File.write(report, OracleSuites.combined_report(results))
      File.read(report).each_line { |line| Terminal.puts(line.chomp) }
      Terminal.puts("report: #{report}")
      results.values.all?(&:passed?) ? 0 : 1
    end

    # The bootable file on Fiasco: good images in both forms under HVF, as
    # the gate's boot_image suite runs them, and each damage the boot checks
    # claim to catch.
    def self.check_boot_image(input_arguments)
      arguments = input_arguments.dup
      accels = [QemuGate::SUITE_ACCELERATOR]
      jobs = 8
      OptionParser.new do |flags|
        flags.on('--jobs N', Integer, 'Build jobs') { |value| jobs = value }
      end.parse!(arguments)
      raise OptionParser::InvalidArgument, 'unexpected arguments' unless arguments.empty?

      runner = Runner.new(owner_root: ROOT, log_dir: File.join(ROOT, 'build/logs'))
      report = BootImageCheck::Run.new(root: ROOT, runner: runner, compiler: ENV.fetch('ERX_CLANG', ''),
                                       linker: ENV.fetch('ERX_LLD', '')).call(accels: accels, jobs: jobs)
      report.fetch(:good).each do |label, run|
        Terminal.puts("boot image #{label}: boots in #{run.fetch(:seconds).round(3)} s; #{run.fetch(:serial)}")
      end
      report.fetch(:refused).each { |name, serial| Terminal.puts("boot image refused: #{name}; #{serial}") }
      0
    end

    # The debug-log probe on Fiasco under HVF, as the gate runs it, each
    # transcript compared with the hosted backend's and the expected one.
    def self.check_debug_log(input_arguments)
      arguments = input_arguments.dup
      accels = [QemuGate::SUITE_ACCELERATOR]
      jobs = 8
      OptionParser.new do |flags|
        flags.on('--jobs N', Integer, 'Build jobs') { |value| jobs = value }
      end.parse!(arguments)
      raise OptionParser::InvalidArgument, 'unexpected arguments' unless arguments.empty?

      DebugLogProbe::Run.new(root: ROOT).call(accels: accels, jobs: jobs).each do |label, run|
        Terminal.puts("debug-log probe #{label}: agrees with hosted; image #{run.fetch(:image_sha256)}; #{run.fetch(:serial)}")
      end
      0
    end

    # Every QEMU suite, discovered from tools/lib/erx/qemu_suites/, under HVF,
    # and under TCG the two things only TCG can do (QemuGate::SMOKE_ACCELERATOR).
    # Exits 0 only when no suite failed or went incomplete. A host whose QEMU
    # lacks either accelerator fails before anything is built: the gate never
    # falls back to the other one. `--suite NAME`, given once or more, runs only
    # those suites, for a change that touches them; the gate's verdict needs all.
    # A boot that passed before on the same inputs is reused from the store
    # ERX_QEMU_RESULTS names (build/qemu-results by default) and listed as
    # reused (QemuReuse); `--fresh` runs every boot, and still records passes.
    # `--remote DEST` (an ssh destination) lets the landing gate move the
    # multi-CPU cells of suites that declare offload to that host, under TCG,
    # while this host's one-minute load average is at least `--busy-load`
    # (default: its CPU count); ERX_QEMU_REMOTE_QEMU, ERX_QEMU_REMOTE_TIMEOUT and
    # ERX_QEMU_REMOTE_DIR override the remote QEMU, GNU timeout and work
    # directory (QemuRemote::Host). `--one-at-a-time` boots every cell here, one
    # after another, as the milestone gate does: `make check-qemu` passes it and
    # none of the remote options.
    def self.check_qemu(input_arguments, runner_class: Runner, fiasco_class: Fiasco)
      arguments = input_arguments.dup
      options = { jobs: 8, suites: [], fresh: false, remote: nil, busy_load: Etc.nprocessors, one_at_a_time: false }
      OptionParser.new do |flags|
        flags.on('--jobs N', Integer, 'Build jobs') { |value| options[:jobs] = value }
        flags.on('--suite NAME', 'Run only this suite; repeatable') { |value| options[:suites] << value }
        flags.on('--fresh', 'Run every boot; reuse none') { options[:fresh] = true }
        flags.on('--one-at-a-time', 'Boot every cell here, one after another') { options[:one_at_a_time] = true }
        flags.on('--remote DEST', 'Move offload suites\' multi-CPU cells to this ssh host when busy') { |value| options[:remote] = value }
        flags.on('--busy-load LOAD', Float, 'One-minute load at which this host is busy') { |value| options[:busy_load] = value }
      end.parse!(arguments)
      raise OptionParser::InvalidArgument, 'unexpected arguments' unless arguments.empty?

      suites = QemuGate.suites
      unless options[:suites].empty?
        unknown = options[:suites] - suites.map(&:name)
        raise OptionParser::InvalidArgument, "unknown suites: #{unknown.join(' ')}" unless unknown.empty?

        suites = suites.select { |suite| options[:suites].include?(suite.name) }
      end

      runner = runner_class.new(owner_root: ROOT, log_dir: File.join(ROOT, 'build/logs'))
      available = QemuGate.available_accelerators(runner: runner)
      missing = QemuGate::REQUIRED_ACCELERATORS - available.to_a
      unless missing.empty?
        Terminal.puts("qemu gate: failed; this host's QEMU does not offer #{missing.join(' and ')}, " \
                      "which the gate needs (offered: #{available.to_a.sort.join(' ')})")
        return 1
      end
      fiasco_class.new(root: ROOT, runner: runner).build(jobs: options.fetch(:jobs))
      store = QemuReuse::Store.new(directory: ENV.fetch('ERX_QEMU_RESULTS', File.join(ROOT, QemuReuse::DEFAULT_STORE)))
      reuse = QemuReuse::Session.new(store: store, harness: QemuReuse.harness_digest(ROOT), fresh: options.fetch(:fresh))
      offload = options.fetch(:remote)&.then do |destination|
        overrides = { work_dir: 'ERX_QEMU_REMOTE_DIR', program: 'ERX_QEMU_REMOTE_QEMU', timeout: 'ERX_QEMU_REMOTE_TIMEOUT' }
                    .filter_map { |key, name| [key, ENV.fetch(name)] if ENV.key?(name) }.to_h
        host = QemuRemote::Host.new(destination: destination, **overrides)
        QemuGate::Offload.new(remote: host, busy_load: options.fetch(:busy_load))
      end
      results = QemuGate.run(suites: suites, context: QemuGate::Context.new(root: ROOT, jobs: options.fetch(:jobs)), reuse: reuse,
                             offload: offload, **(options.fetch(:one_at_a_time) ? { host_load: -> {} } : {}))
      QemuGate.table(results, remote: offload&.remote).each { |line| Terminal.puts(line) }
      QemuGate.overall(results.values.map { |entry| QemuGate.status(entry) }) == 'passed' ? 0 : 1
    end

    # The conformance roster under HVF at each CPU count, as the gate runs it.
    # Succeeds only when every configuration passed; an unsupported, partial
    # or timed-out configuration leaves the matrix incomplete.
    def self.conformance(input_arguments)
      arguments = input_arguments.dup
      options = { image: Fiasco.new(root: ROOT).image_path, roster: File.join(ROOT, 'test/conformance/roster.txt'),
                  accels: [QemuGate::SUITE_ACCELERATOR], cpus: [1, 4] }
      OptionParser.new do |flags|
        flags.on('--image PATH', 'Explicit built guest image') { |value| options[:image] = value }
        flags.on('--roster PATH', 'Conformance roster') { |value| options[:roster] = value }
        flags.on('--cpus LIST', Array, 'CPU counts') do |value|
          options[:cpus] = value.map { |cpus| Integer(cpus, exception: false) || raise(OptionParser::InvalidArgument, cpus) }
        end
      end.parse!(arguments)
      raise OptionParser::InvalidArgument, 'unexpected arguments' unless arguments.empty?
      roster = Conformance.roster(BoundedFile.read(options.fetch(:roster), maximum: 1 << 20),
                                  path: options.fetch(:roster))
      configs = options.fetch(:accels).product(options.fetch(:cpus)).map do |accel, cpus|
        Conformance::Config.new(accel: accel, cpus: cpus)
      end
      matrix = Conformance::Run.new(root: ROOT).run(image: options.fetch(:image), roster: roster, configs: configs)
      Conformance.table(matrix).each { |line| Terminal.puts(line) }
      matrix.fetch('status') == 'passed' ? 0 : 1
    end

    def self.bench(input_arguments)
      arguments = input_arguments.dup
      name = arguments.shift
      return bench_import(arguments) if name == 'import'
      return bench_net(name, arguments) if name.to_s.start_with?('net-')
      return bench_board(name, arguments) if arguments.any? { |argument| argument == '--env' || argument.start_with?('--env=') }

      options = {}
      OptionParser.new do |flags|
        flags.on('--flavour NAME', %w[emu jit]) { |value| options[:flavour] = value }
        flags.on('--iterations N', Integer, 'host benchmarks only') { |value| options[:iterations] = value }
        flags.on('--samples N', Integer, 'host benchmarks only') { |value| options[:samples] = value }
        flags.on('--image PATH', 'boot, g3 and bytes only: boot this built image instead of building one') { |value| options[:image] = value }
        flags.on('--runs N', Integer, 'boot only: the number of boots') { |value| options[:runs] = value }
        flags.on('--accel NAME', %w[tcg hvf], 'boot, g3, g5, bytes and web only: the guest accelerator') { |value| options[:accel] = value }
        flags.on('--systems LIST', Array, 'a declared benchmark only: the systems booted side by side under HVF') { |value| options[:systems] = value }
        flags.on('--profile NAME', 'with --systems only: landing, one round, or full, three') { |value| options[:profile] = value }
      end.parse!(arguments)
      raise OptionParser::InvalidArgument, 'unexpected arguments' unless arguments.empty?
      return bench_session(name, options) if options.key?(:systems)
      raise OptionParser::InvalidArgument, '--profile applies only with --systems' if options.key?(:profile)

      inapplicable = { 'boot' => %i[iterations samples flavour], 'g3' => %i[iterations samples runs],
                       'g5' => %i[iterations samples image flavour runs],
                       'bytes' => %i[iterations samples flavour runs],
                       'web' => %i[iterations samples image flavour runs] }.fetch(name, %i[image accel runs])
      refused = inapplicable.select { |option| options.key?(option) }
      unless refused.empty?
        raise OptionParser::InvalidArgument, "#{refused.map { |option| "--#{option}" }.join(', ')} do not apply to bench #{name}"
      end
      return bench_boot(options) if name == 'boot'
      return bench_g3(options) if name == 'g3'
      return bench_g5(options) if name == 'g5'
      return bench_bytes(options) if name == 'bytes'
      return bench_web(options) if name == 'web'

      report = Bench.new(root: ROOT).run(name, flavour: options.fetch(:flavour, 'emu'),
                                         iterations: options.fetch(:iterations, 10_000),
                                         samples: options.fetch(:samples, 7))
      Terminal.puts("native host benchmark: #{report.fetch('report')}")
      0
    end

    # tools/erx bench NAME --env pi4-4gb-erxos --console DEVICE|tcp:HOST:PORT --ssh DEST --key FILE [--http DIR]
    # [--runs N] [--profile landing|full] [--set DIR ...] (docs/design-bench.md, "The walk"): every
    # refusal before anything is built, then the default set built (or each --set read) and
    # the walk (BoardRun). The environment is the board's for a benchmark with a native
    # bench guest, whose set BoardSets lays out.
    def self.bench_board(name, arguments)
      require_relative 'lib/erx/l4re_board'
      return bench_board_l4re(name, arguments) if arguments.each_cons(2).include?(['--env', L4ReBoard::ENVIRONMENT]) ||
                                                 arguments.include?("--env=#{L4ReBoard::ENVIRONMENT}")

      require_relative 'lib/erx/bench_suite'
      require_relative 'lib/erx/board_run'
      require_relative 'lib/erx/fsimg'
      options = { runs: 1, sets: [], http: Netboot::DEFAULT_HTTP_ROOT }
      OptionParser.new do |flags|
        flags.on('--env NAME') { |value| options[:env] = value }
        flags.on('--console DEVICE|tcp:HOST:PORT') { |value| options[:console] = value }
        flags.on('--ssh DEST') { |value| options[:ssh] = value }
        flags.on('--key FILE') { |value| options[:key] = value }
        flags.on('--http DIR') { |value| options[:http] = value }
        flags.on('--runs N', Integer) { |value| options[:runs] = value }
        flags.on('--profile NAME', %w[landing full]) { |value| options[:profile] = value }
        flags.on('--set DIR') { |value| options[:sets] << File.expand_path(value) }
      end.parse!(arguments)
      no_arguments(arguments)
      BenchSuite.benchmark(name)
      declared = NativeBench::GUESTS.key?(name) ? [BoardRun::ENVIRONMENT] : []
      raise Error, "bench #{name} declares no environment #{options[:env]}; it declares: #{declared.join(', ').then { |listed| listed.empty? ? 'none run on a board' : listed }}" unless
        declared.include?(options[:env])

      missing = %i[console ssh key].reject { |option| options[option] }
      raise Error, "bench --env #{BoardRun::ENVIRONMENT} needs #{missing.map { |option| "--#{option}" }.join(', ')}" unless missing.empty?
      raise Error, 'bench: --runs is below 1' unless options[:runs].positive?
      raise Error, 'bench: --profile full: the board sets are built only in the landing form' if options[:profile] == 'full'

      history = BenchRecord.history
      BenchRecord::Destination.new(history: history, erxos_root: ROOT)
      shell = BoardRun::Ssh.new(options[:ssh])
      NetbootEntry.signing_key(options[:key])
      subjects = options[:sets].map { |directory| BoardRun.directory_subject(directory) }
      runner = Runner.new(owner_root: ROOT, log_dir: File.join(ROOT, 'build/logs'))
      if subjects.empty?
        laid = NativeBench::BoardSets.new(root: ROOT, platform: Platform.load(root: ROOT, name: Netboot::PLATFORM), runner: runner)
                                     .call([name]).fetch(name)
        subjects = [BoardRun.laid_subject(laid)]
      end

      clock = -> { Process.clock_gettime(Process::CLOCK_MONOTONIC) }
      fsimg = Fsimg.locate(root: ROOT)
      walk = BoardRun.new(
        root: ROOT, www: options[:http], shell: shell,
        prepare: ->(**queue) { Netboot.prepare(**queue, runner: runner, fsimg: fsimg) },
        console: ->(log:) { BoardConsole.open(options[:console], log: log, clock: clock) },
        clock: clock, out: Terminal.method(:puts), codec: ABI::Codec.new(ABI::Generator.plan(root: ROOT).schema),
        record: ->(ran) { bench_board_record(name, ran, history) }
      ).call(benchmark: name, subjects: subjects, runs: options[:runs], key: options[:key])
      walk.ending == 'returned' ? 0 : 1
    end

    # The records of a board walk that ended (BoardRecord), one per set, written under
    # history; when they cannot be, the walk's files stay for `tools/erx bench import`,
    # whose command line is printed before the failure is raised.
    def self.bench_board_record(name, ran, history)
      require_relative 'lib/erx/board_record'
      log = BoundedFile.read(File.join(ran.directory, BoardRun::LOG), maximum: BoardLog.max_bytes(ran.queue))
      made = BoardRecord.recorded(log, queue: ran.queue, walk: ran.walk, readings: { 'before' => ran.before&.text, 'after' => ran.after.text },
                                       started_by: 'manual')
      BoardRecord.write(made, history: history, root: ROOT).each { |run| Terminal.puts("bench: recorded #{run}") }
    rescue Error, SystemCallError
      import = ['tools/erx', 'bench', 'import', name, '--env', BoardRun::ENVIRONMENT, '--queue', File.join(ran.directory, BoardFiles::QUEUE),
                File.join(ran.directory, BoardRun::LOG)]
      Terminal.puts("bench: the board run's record was not written; once the cause below is fixed, import it with: #{Netboot.shell_line(import)}")
      raise
    end

    # tools/erx bench NAME --env pi4-4gb-l4re --console DEVICE|tcp:HOST:PORT --ssh DEST --key FILE [--http DIR]
    # (docs/design-bench.md, "L4Re on the board"): L4Re's board build laid out as a one-CPU
    # bench set, netbooted, its run walked to the board's return, and its log imported and
    # set beside erXos's newest board record of NAME. Exit status 0 only when Benchmarks
    # done. came and the board came back.
    def self.bench_board_l4re(name, arguments)
      require_relative 'lib/erx/fsimg'
      options = { http: Netboot::DEFAULT_HTTP_ROOT }
      OptionParser.new do |flags|
        flags.on('--env NAME') { |value| options[:env] = value }
        flags.on('--console DEVICE') { |value| options[:console] = value }
        flags.on('--http DIR') { |value| options[:http] = value }
        flags.on('--ssh DEST') { |value| options[:ssh] = value }
        flags.on('--key FILE') { |value| options[:key] = value }
      end.parse!(arguments)
      no_arguments(arguments)
      benchmark = BenchSuite.benchmark(name)
      raise Error, "bench #{name} has no cell with an l4re counterpart" if L4ReBoard.asked(benchmark).empty?

      missing = %i[console ssh key].reject { |option| options[option] }
      raise Error, "bench --env #{L4ReBoard::ENVIRONMENT} needs #{missing.map { |option| "--#{option}" }.join(', ')}" unless missing.empty?

      history = BenchRecord.history
      BenchRecord::Destination.new(history: history, erxos_root: ROOT)
      NetbootEntry.signing_key(options[:key])
      runner = Runner.new(owner_root: ROOT, log_dir: File.join(ROOT, 'build/logs'))
      revision = SourceRevision.read(root: ROOT, runner: runner) || raise(Error, "bench: #{ROOT} is not a git checkout")
      set = L4ReBoard.lay_out(root: ROOT, runner: runner, platform: Platform.load(root: ROOT, name: Netboot::PLATFORM),
                              compiler: ENV.fetch('ERX_CLANG', ''), linker: ENV.fetch('ERX_LLD', ''))
      clock = -> { Process.clock_gettime(Process::CLOCK_MONOTONIC) }
      fsimg = Fsimg.locate(root: ROOT)
      ran = L4ReBoard::Run.new(
        root: ROOT, www: options[:http], shell: BoardRun::Ssh.new(options[:ssh]),
        prepare: ->(**queue) { Netboot.prepare(**queue, runner: runner, fsimg: fsimg) },
        console: ->(log:, classify:) { BoardConsole.open(options[:console], log: log, clock: clock, classify: classify) },
        clock: clock, out: Terminal.method(:puts)
      ).call(set: set, key: options[:key])
      if ran.done
        bench_l4re_record(benchmark, subject: L4ReBench::Build.new(directory: File.join(ROOT, L4ReBoard::BUILD),
                                                                   bootable: L4ReBoard::BOOTABLE).record_path,
                                     log: ran.log, history: history, revision: revision)
      end
      ran.done && ran.ending == 'returned' ? 0 : 1
    end

    # Writes L4Re's board record of benchmark and prints the board's side-by-side table.
    def self.bench_l4re_record(benchmark, subject:, log:, history:, revision:)
      run, record = L4ReBoard.import(benchmark.name, subject: subject, log: log, root: ROOT, history: history, revision: revision)
      Terminal.puts("bench: recorded #{run}")
      L4ReBoard.table(benchmark, record, history: history).each { |line| Terminal.puts(LineEscape.escape(line)) }
    end

    # tools/erx bench import NAME --env pi4-4gb-erxos --queue FILE [--profile landing] LOG
    # (docs/design-bench.md, "Importing a log"): the records of a board walk made from its
    # console log, its queue file and the walk.json beside it when there is one.
    def self.bench_import(arguments)
      require_relative 'lib/erx/board_record'
      require_relative 'lib/erx/l4re_board'
      require_relative 'lib/erx/board_run'
      options = {}
      OptionParser.new do |flags|
        flags.on('--env NAME') { |value| options[:env] = value }
        flags.on('--queue FILE') { |value| options[:queue] = value }
        flags.on('--subject FILE') { |value| options[:subject] = value }
        flags.on('--profile NAME', %w[landing full]) { |value| options[:profile] = value }
      end.parse!(arguments)
      return bench_import_l4re(arguments, options) if options[:env] == L4ReBoard::ENVIRONMENT
      raise OptionParser::InvalidArgument, 'usage: tools/erx bench import NAME --env ENV --queue FILE [--profile landing] LOG' unless
        arguments.size == 2 && options[:queue]
      raise Error, "bench import: --env #{options[:env]} is not #{BoardRun::ENVIRONMENT}, the one environment a board log is imported into" unless
        options[:env] == BoardRun::ENVIRONMENT
      raise Error, 'bench import: --profile full: the board sets are built only in the landing form' if options[:profile] == 'full'

      name, log = arguments
      BenchSuite.benchmark(name)
      BoardRecord.import(name, queue: options[:queue], log: log, root: ROOT, history: BenchRecord.history)
                 .each { |run| Terminal.puts("bench: recorded #{run}") }
      0
    end

    # tools/erx bench import NAME --env pi4-4gb-l4re --subject FILE LOG (docs/design-bench.md,
    # "L4Re on the board"): L4Re's board record of NAME from its console log and the build
    # record at FILE, set beside erXos's newest board record of NAME.
    def self.bench_import_l4re(arguments, options)
      raise OptionParser::InvalidArgument, "usage: tools/erx bench import NAME --env #{L4ReBoard::ENVIRONMENT} --subject FILE LOG" unless
        arguments.size == 2 && options[:subject] && !options[:queue] && !options[:profile]

      name, log = arguments
      revision = SourceRevision.read(root: ROOT, runner: Runner.new(owner_root: ROOT, log_dir: File.join(ROOT, 'build/logs'))) ||
                 raise(Error, "bench import: #{ROOT} is not a git checkout")
      bench_l4re_record(BenchSuite.benchmark(name), subject: options[:subject], log: log, history: BenchRecord.history, revision: revision)
      0
    end

    # A comparison session (docs/design-bench.md, "A comparison session"): each listed
    # system's guest booted under HVF in rounds, each boot one run in the history, then
    # the side-by-side tables of the runs. The history root is checked before any boot.
    # The exit status is nonzero if any boot failed.
    def self.bench_session(name, options)
      refused = options.keys - %i[systems profile]
      unless refused.empty?
        raise OptionParser::InvalidArgument, "#{refused.map { |option| "--#{option}" }.join(', ')} do not apply to bench #{name} --systems"
      end
      benchmark = BenchSuite.benchmark(name)
      systems = options.fetch(:systems)
      runner = Runner.new(owner_root: ROOT, log_dir: File.join(ROOT, 'build/logs'))
      history = BenchRecord.history
      BenchRecord::Destination.new(history: history, erxos_root: ROOT)
      guests = [NativeBench::Guest.new(run: NativeBench::Run.new(root: ROOT, runner: runner)),
                XdomainBench::Guest.new(run: XdomainBench::Run.new(root: ROOT, runner: runner)),
                L4ReBench::Guest.new(build: L4ReBench::Build.new(directory: File.join(ROOT, 'build/l4re')),
                                     qemu: Qemu.new(root: ROOT, runner: runner), platform: Platform.development(ROOT)),
                LinuxGuest::Guest.new(root: ROOT, runner: runner),
                LinuxGuest::Guest.new(root: ROOT, runner: runner, boot: 'posix'),
                PosixBench::Guest.new(root: ROOT, runner: runner),
                LinuxErlangGuest::Guest.new(root: ROOT, runner: runner)]
      write = ->(record, logs) { BenchRecord.write(record, history: history, erxos_root: ROOT, logs: logs) }
      session = BenchSession::Run.new(guests: guests, host: BenchSystem.host(kind: BenchSession::KIND, root: ROOT, runner: runner),
                                      write: write, load: -> { QemuGate.one_minute_load })
      result = session.call(benchmark, systems: systems, profile: options.fetch(:profile, 'landing'))
      result.fetch(:written).each { |run| Terminal.puts("bench: recorded #{run}") }
      result.fetch(:notes).each { |note| Terminal.puts(note) }
      BenchSideBySide.render(BenchSideBySide.tables(benchmark, result.fetch(:runs), systems: systems)).each { |line| Terminal.puts(line) }
      result.fetch(:failed).empty? ? 0 : 1
    end

    # The network benchmarks (docs/design-network-stack.md, "Benchmarks and targets"):
    # net-freebsd runs erx_net and lwIP on the FreeBSD test host and prints one table. The exit
    # status is nonzero if any run failed.
    def self.bench_net(name, arguments)
      raise OptionParser::InvalidArgument, "unknown benchmark: #{name}" unless name == 'net-freebsd'

      host_variable = NetBenchFreebsd::HOST_VARIABLE
      setup = NetBenchFreebsd::DEFAULTS.merge(host: ENV.fetch(host_variable, nil))
      only = nil
      fast_path = false
      out = nil
      OptionParser.new do |flags|
        flags.on('--host H', "the FreeBSD test host's ssh name (default $#{host_variable})") { |value| setup[:host] = value }
        %w[jail tap peer_ip remote_dir lwip_src].each do |key|
          flags.on("--#{key.tr('_', '-')} VALUE") { |value| setup[key.to_sym] = value }
        end
        flags.on('--runs N', Integer, 'runs per cell, odd (default 3)') { |value| setup[:runs] = value }
        flags.on('--only LIST', Array, "workloads: #{NetBench::WORKLOADS.map(&:name).join(',')}") { |value| only = value }
        flags.on('--require-fast-path', 'fail a run whose erx_net counters show no runs or merges') { fast_path = true }
        flags.on('--out DIR', 'output directory (default build/bench/net-freebsd-STAMP)') { |value| out = value }
      end.parse!(arguments)
      raise OptionParser::InvalidArgument, 'unexpected arguments' unless arguments.empty?
      if setup[:host].to_s.empty?
        raise OptionParser::MissingArgument, "--host H or #{host_variable}: the FreeBSD test host to run on"
      end

      unknown = Array(only) - NetBench::WORKLOADS.map(&:name)
      raise OptionParser::InvalidArgument, "unknown workloads: #{unknown.join(', ')}" unless unknown.empty?

      runner = begin
        NetBenchFreebsd::Runner.new(root: ROOT, setup: NetBenchFreebsd::Setup.new(**setup), output: out)
      rescue ArgumentError => error
        raise OptionParser::InvalidArgument, error.message
      end
      outcome = runner.call(only: only, require_fast_path: fast_path)
      outcome.lines.each { |line| Terminal.puts(line) }
      outcome.failures.empty? ? 0 : 1
    end

    # Gate G5's BeamAsm measurements: interpreter and BeamAsm domains on one workload under
    # QEMU (BenchG5). The exit status is nonzero unless every domain measured and halted.
    def self.bench_g5(options)
      raise OptionParser::MissingArgument, '--accel' unless options[:accel]

      report = BenchG5.new(root: ROOT).run(accel: options.fetch(:accel))
      Terminal.puts("G5 benchmark (#{options.fetch(:accel)}): #{report.fetch('report')}")
      Terminal.puts("G5 BeamAsm speedup: #{report.fetch('speedup').inspect}")
      report.fetch('complete') ? 0 : 1
    end

    # erx_bytes's network primitives as the stack calls them, on erXos under QEMU HVF
    # (BenchBytes). The exit status is nonzero unless the guest printed its measurement.
    def self.bench_bytes(options)
      raise OptionParser::InvalidArgument, 'bench bytes runs under --accel hvf only' unless options[:accel] == 'hvf'

      report = BenchBytes.new(root: ROOT).run(image: options[:image])
      Terminal.puts("bytes benchmark (hvf): #{report.fetch('report')}")
      Terminal.puts("bytes medians, ns per call less the loop's: #{report.fetch('net_of_loop').inspect}")
      report.fetch('complete') ? 0 : 1
    end

    # Gate GW: a record view's round trip over tools/erx web, unpaced and at a
    # 115,200-baud UART's rate (BenchWeb). The exit status is nonzero unless both links
    # measured both views.
    def self.bench_web(options)
      raise OptionParser::InvalidArgument, 'bench web runs under --accel hvf only' unless options[:accel] == 'hvf'

      report = BenchWeb.new(root: ROOT).run
      Terminal.puts("web benchmark (hvf): #{report.fetch('report')}")
      report.fetch('links').each do |link, targets|
        targets.each do |target, summary|
          Terminal.puts("web #{link} #{target}: median #{summary.fetch('median_ms')} ms, " \
                        "p95 #{summary.fetch('p95_ms')} ms, update #{summary.fetch('update_bytes').join('..')} bytes")
        end
      end
      Terminal.puts("web benchmark failed: #{LineEscape.escape(report.fetch('error'))}") if report.fetch('error')
      report.fetch('complete') ? 0 : 1
    end

    # Boot time of the development image to the kernel banner, the root task, the system
    # domain's Erlang banner and the command shell, N boots, median and spread (BenchBoot).
    # A boot that does not reach the shell fails the run: the report is written all the same,
    # and the exit status is nonzero unless every boot passed and every mark was reached.
    def self.bench_boot(options)
      raise OptionParser::MissingArgument, '--accel' unless options[:accel]

      runner = Runner.new(owner_root: ROOT, log_dir: File.join(ROOT, 'build/logs'))
      report = BenchBoot.run(root: ROOT, runner: runner, plan: BenchBoot::PLANS.fetch(options.fetch(:accel)),
                             image: options[:image], runs: options[:runs])
      Terminal.puts("boot benchmark (#{options.fetch(:accel)}, #{report.fetch('runs')} boots): #{report.fetch('report')}")
      report.fetch('summary').each do |mark, entry|
        Terminal.puts(BenchBoot.format_line(mark, entry))
      end
      failure = report.fetch('failure')
      Terminal.puts("boot #{failure.fetch('boot')} failed: #{failure.fetch('error')}") if failure
      report.fetch('complete') ? 0 : 1
    end

    # Gate G3: erXos under QEMU and on stock OTP on this host (docs/research-g3-baseline.md).
    # The report is written however far the guest got; the exit status is nonzero unless every
    # workload was measured.
    def self.bench_g3(options)
      raise OptionParser::MissingArgument, '--accel' unless options[:accel]

      report = BenchG3.new(root: ROOT).run(accel: options.fetch(:accel), flavour: options.fetch(:flavour, 'emu'),
                                           image: options[:image])
      Terminal.puts("G3 benchmark (#{options.fetch(:accel)}): #{report.fetch('report')}")
      statuses = report.fetch('comparison').map { |workload, entry| "#{workload} #{entry.fetch('status')}" }
      Terminal.puts("G3 workloads: #{statuses.join(', ')}")
      report.fetch('complete') ? 0 : 1
    end

    def self.status(arguments, directories: Dir)
      raise OptionParser::InvalidArgument, 'unexpected arguments' unless arguments.empty?

      records = directories.glob(File.join(ROOT, 'build/logs/*.json')).sort.map do |path|
        status_record(BoundedFile.read(path, maximum: 65_536))
      end
      active = records.select { |record| record.fetch('state') == 'running' }
      active.each do |record|
        age = Time.now - record.fetch('started_at')
        Terminal.puts("recorded running (liveness unknown) #{record.fetch('argv').first}: age #{age.round}s, " \
                      "deadline #{record.fetch('deadline_seconds')}s; #{record.fetch('log')}")
      end
      Terminal.puts('no commands recorded as running') if active.empty?
      0
    end

    def self.status_record(bytes)
      record = JsonInput.parse(bytes, max_bytes: 65_536, label: 'runner status record')
      unless record.is_a?(Hash) &&
             %w[running succeeded failed timed_out cancelled setup_error].include?(record['state']) &&
             record['argv'].is_a?(Array) && record['argv'].size.between?(1, 1024) &&
             record['argv'].all? { |value| value.is_a?(String) && value.bytesize <= 4096 && !value.include?("\0") } &&
             record['started_at'].is_a?(String) &&
             /\A[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z\z/.match?(record['started_at']) &&
             record['deadline_seconds'].is_a?(Integer) && record['deadline_seconds'].between?(1, 86_400) &&
             record['log'].is_a?(String) && record['log'].bytesize.between?(1, 4096) && !record['log'].include?("\0")
        raise Error, 'invalid runner status record fields'
      end
      record.merge('started_at' => Time.iso8601(record.fetch('started_at'))).freeze
    rescue ArgumentError
      raise Error, 'invalid runner status record start time'
    end

    def self.check_tla(input_arguments)
      arguments = input_arguments.dup
      filter = nil
      no_cache = ENV['TLA_NO_CACHE'] == '1'
      parser = OptionParser.new do |options|
        options.on('--filter TEXT', 'Select configuration ids containing this text') { |value| filter = value }
        options.on('--no-cache', 'Check without reusing earlier evidence') { no_cache = true }
      end
      parser.parse!(arguments)
      raise OptionParser::InvalidArgument, 'unexpected arguments' unless arguments.empty?
      Tla.new(root: ROOT).run(filter: filter, no_cache: no_cache)
      0
    end

    def self.check_cbmc(input_arguments)
      arguments = input_arguments.dup
      filter = nil
      parser = OptionParser.new do |options|
        options.on('--filter TEXT', 'Select harness ids containing this text') { |value| filter = value }
      end
      parser.parse!(arguments)
      raise OptionParser::InvalidArgument, 'unexpected arguments' unless arguments.empty?
      Cbmc.new(root: ROOT).run(filter: filter)
      0
    end

    private_class_method :host_environment, :with_test_runtime,
                         :run_tests, :fuzz_c, :fuzz_ruby, :no_arguments, :status_record,
                         :package_sets, :fetch_sources
  end
end

