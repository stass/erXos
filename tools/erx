    # tools/erx sysreg refresh [--verify] [--root PATH]: the one reader of Arm's
    # fetched archive. It rewrites hw/sysreg/aarch64.json from the pinned
    # Registers.json, or with --verify only compares; no gate runs it.
    def self.sysreg(input_arguments)
      arguments = input_arguments.dup
      verify = false
      root = ROOT
      parser = OptionParser.new do |options|
        options.banner = 'usage: tools/erx sysreg refresh [--verify] [--root PATH]'
        options.on('--verify', "Compare with Arm's pinned source without writing") { verify = true }
        options.on('--root PATH', 'Tree to refresh (default: this checkout)') { |path| root = File.expand_path(path) }
      end
      parser.parse!(arguments)
      raise OptionParser::InvalidArgument, parser.banner unless arguments == ['refresh']

      if verify
        Sysreg.verify(root: root)
        Terminal.puts("#{Sysreg::SPECIFICATION} matches Arm's pinned source")
      else
        changed = Sysreg.refresh(root: root)
        Terminal.puts("#{Sysreg::SPECIFICATION} #{changed ? 'rewritten' : 'unchanged'} from Arm's pinned source")
      end
      0
    end

    # Runs musl's libc-test in tasks on one accelerator and CPU count: tools/erx check-libc-test ACCEL CPUS.
    # It fails on any result that differs from its line in test/conformance/libc-test-verdicts.txt,
    # and on a boot that leaked the pool or never said whether it did.
    def self.check_libc_test(arguments)
      accel, cpus = arguments
      raise OptionParser::InvalidArgument, 'check-libc-test ACCEL CPUS' unless arguments.size == 2 && cpus.match?(/\A[1-9][0-9]*\z/)

      require_relative 'lib/erx/libc_test'
      verdicts = LibcTest.load_verdicts(ROOT)
      outcome = LibcTest::Run.new(root: ROOT).call(accel: accel, cpus: cpus.to_i)
      Terminal.puts("#{outcome.fetch(:report)}: #{outcome.fetch(:totals)}; pool leaks in boots " \
                    "#{outcome.fetch(:pool_leaks_in_boots)}, unknown in boots #{outcome.fetch(:pool_unknown_in_boots)}")
      problems = LibcTest.check_problems(outcome, verdicts: verdicts)
      problems.each { |problem| Terminal.puts("libc-test: #{problem}") }
      problems.empty? ? 0 : 1
    end

    # The suites the system domain runs under HVF, compared with stock: OTP's
    # four groups of docs/plan.md's M3 (OracleSuites::GROUPS) whole, then
    # musl's libc-test in test tasks on LIBC_TEST_CPUS CPUs. It exits 0 when
    # every part passed, and 1 when a part failed or this host's QEMU does
    # not offer HVF.
    LIBC_TEST_CPUS = 4
    # Each side's deadline: stock, the slower side, runs the emulator group in
    # about 6,000 s and the kernel group in about 6,700 s at the guest's one
    # scheduler (erxos-history oracle-qemu/emulator/2026-11-07,
    # oracle-qemu/kernel/2026-11-07-whole, both on a loaded host).
    ORACLE_DEADLINE = 10_800

    def self.check_oracle(arguments, qemu_class: OracleQemu, accelerators: nil, libc_test: method(:check_libc_test))
      no_arguments(arguments)
      offered = accelerators || QemuGate.available_accelerators(runner: Runner.new(owner_root: ROOT, log_dir: File.join(ROOT, 'build/logs')))
      accel = QemuGate::SUITE_ACCELERATOR
      unless offered.include?(accel)
        Terminal.puts("failed: this host's QEMU does not offer #{accel}, which the oracle run needs")
        return 1
      end
      status = oracle_qemu(['--accel', accel, '--out', File.join(ROOT, "build/check-oracle/#{accel}"), '--deadline', ORACLE_DEADLINE.to_s,
                            '--suites', OracleSuites::GROUPS.keys.join(',')], qemu_class: qemu_class)
      Terminal.puts("oracle qemu #{accel}: #{status.zero? ? 'passed' : 'failed'}")
      libc = libc_test.call([accel, LIBC_TEST_CPUS.to_s])
      Terminal.puts("libc-test #{accel} #{LIBC_TEST_CPUS} CPUs: #{libc.zero? ? 'passed' : 'failed'}")
      status.zero? && libc.zero? ? 0 : 1
    end

    # tools/erx load and watch (CodeCommands), with the oracle's erlc for sources.
    def self.code_command(command, arguments)
      compile = ErlangCompile.for_tree(root: ROOT)
      CodeCommands.public_send(command, arguments, connect: CodeCommands.method(:connect_socket), compile: compile,
                                                   out: Terminal.method(:puts))
    end

    # tools/erx files --socket PATH --listen SOCK [--build HEX] [--once]: relays the UNIX
    # socket SOCK, in an owner-only directory, to the host link's files stream of the guest
    # whose host link socket is PATH (FilesRelay); --once serves one client and exits.
    def self.files_command(arguments)
      options = { once: false }
      OptionParser.new do |flags|
        flags.on('--socket PATH') { |value| options[:socket] = value }
        flags.on('--listen SOCK') { |value| options[:listen] = value }
        flags.on('--build HEX', /\A\h+\z/) { |value| options[:build] = value.downcase }
        flags.on('--once') { options[:once] = true }
      end.parse!(arguments)
      no_arguments(arguments)
      raise OptionParser::InvalidArgument, 'files needs --socket PATH and --listen SOCK' unless
        options[:socket] && options[:listen]

      require_relative 'lib/erx/files_relay'
      UNIXSocket.open(options.fetch(:socket)) do |io|
        link = HostlinkClient.new(io: io, expected_build: options[:build])
        FilesRelay.new(link: link, listen: options.fetch(:listen), out: Terminal.method(:puts))
                  .serve(connections: options[:once] ? 1 : nil)
      end
      0
    end

