    # The BeamAsm image, linked as the production image links it for its domains, into
    # build/runtime/native-jit/image; Fiasco's build must have run.
    def self.build_jit_runtime(jobs)
      require_relative 'lib/erx/native_jit_runtime'

      runner = Runner.new(owner_root: ROOT, log_dir: File.join(ROOT, 'build/logs'))
      compiler = ENV.fetch('ERX_CLANG', '')
      linker = ENV.fetch('ERX_LLD', '')
      fiasco = Fiasco.new(root: ROOT, runner: runner, compiler: compiler)
      interpreter = NativeRuntime.new(root: ROOT, runner: runner, compiler: compiler, linker: linker, fiasco: fiasco).build(jobs: jobs)
      jit = NativeJitRuntime.new(root: ROOT, runner: runner, compiler: compiler, linker: linker, fiasco: fiasco)
                            .build(interpreter: interpreter, jobs: jobs)
      NativeRoot.new(root: ROOT, runner: runner, compiler: compiler, linker: linker, fiasco: fiasco)
                .build_jit_runtime_receipted(directory: File.join(ROOT, NativeJitRuntime::BASE, 'image'),
                                             archives: jit.link_archives(libgcc: fiasco.user_library('libgcc.a')))
                .fetch(:program)
