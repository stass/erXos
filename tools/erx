    # A runtime that is not built, or is older than the tree, fails here: nothing
    # was read, so nothing passed.
    def self.check_runtime_seam(arguments, **)
      raise OptionParser::InvalidArgument, 'unexpected arguments' unless arguments.empty?

      Runtime.check_current(root: ROOT)
      output = Runtime.output(root: ROOT)
      report = RuntimeSeam.check_objects(objects: RuntimeSeam.objects(output), executable: output.beam, liberx: output.liberx,
